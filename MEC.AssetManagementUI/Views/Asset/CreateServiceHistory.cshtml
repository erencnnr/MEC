@model MEC.AssetManagementUI.Models.ServiceHistoryModel.ServiceHistoryCreateViewModel

@{
    ViewData["Title"] = "Yeni Servis Kaydı";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Servis Kaydı</h6>
            <a asp-action="AssetInfo" asp-route-id="@Model.AssetId" asp-route-activeTab="service" class="btn btn-sm btn-secondary">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
        <div class="card-body">
            <form asp-action="CreateServiceHistory" method="post">
                <input type="hidden" asp-for="AssetId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Eşya</label>
                        <input class="form-control" value="@(ViewBag.AssetName ?? "-")" disabled />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ServiceCompany" class="form-label fw-bold">Servis Firması</label>
                        <input asp-for="ServiceCompany" class="form-control" placeholder="Örn: Yetkili Servis A.Ş." />
                        <span asp-validation-for="ServiceCompany" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SendDate" class="form-label fw-bold">Gönderim Tarihi</label>
                        <input asp-for="SendDate" class="form-control" type="date" />
                        <span asp-validation-for="SendDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ReturnDate" class="form-label fw-bold">Dönüş Tarihi</label>
                        <input asp-for="ReturnDate" class="form-control" type="date" />
                        <span asp-validation-for="ReturnDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Cost" class="form-label fw-bold">Maliyet</label>
                        <input asp-for="Cost" class="form-control" type="number" step="0.01" placeholder="Örn: 1500" />
                        <span asp-validation-for="Cost" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="IsWarranty" />
                            <label class="form-check-label fw-bold" asp-for="IsWarranty">Garanti Kapsamında</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Servis açıklaması..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
