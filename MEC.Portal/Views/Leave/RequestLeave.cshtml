@model MEC.Portal.Models.LeaveRequestViewModel

@{
    ViewData["Title"] = "İzin Talep Formu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .weekend-day {
        color: #dc3545 !important; /* Kırmızı renk */
        font-weight: bold;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-calendar-check"></i> İzin Talep Formu</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        Lütfen izin kullanmak istediğiniz tarih aralığını seçin ve talebinizi iletin.
                    </p>

                    <form asp-action="RequestLeave" method="post">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Başlangıç Tarihi</label>
                                <input asp-for="StartDate" class="form-control" placeholder="Tarih Seçiniz" required autocomplete="off" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Bitiş Tarihi</label>
                                <input asp-for="EndDate" class="form-control" placeholder="Tarih Seçiniz" required autocomplete="off" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">İzin Nedeni / Açıklama</label>
                            <textarea asp-for="Reason" class="form-control" rows="4" placeholder="Örn: Yıllık izin, Sağlık sorunu, Özel işlerim vb..." required></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">
                                Talebi Gönder
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {

            // 1. ORTAK AYAR: Hafta sonlarını (Cumartesi=6, Pazar=0) bulup kırmızı sınıfını ekleyen fonksiyon
            const flatpickrConfig = {
                locale: "tr",
                dateFormat: "d.m.Y",
                onDayCreate: function(dObj, dStr, fp, dayElem) {
                    if (dayElem.dateObj.getDay() === 0 || dayElem.dateObj.getDay() === 6) {
                        dayElem.classList.add("weekend-day");
                    }
                }
            };

            // 2. BİTİŞ TAKVİMİNİ OLUŞTUR (Önce bunu oluşturuyoruz ki başlangıç değişince buna müdahale edebilelim)
            const endDatePicker = flatpickr("#EndDate", flatpickrConfig);

            // 3. BAŞLANGIÇ TAKVİMİNİ OLUŞTUR VE BİTİŞE BAĞLA
            flatpickr("#StartDate", {
                ...flatpickrConfig, // Ortak ayarları (hafta sonu kırmızısı vs.) dahil et
                onChange: function(selectedDates, dateStr, instance) {
                    // Kullanıcı başlangıç tarihi seçtiğinde çalışır
                    if (selectedDates.length > 0) {
                        // Bitiş takviminin seçilebilir en küçük gününü (minDate), Başlangıç tarihi olarak ayarla!
                        endDatePicker.set("minDate", selectedDates[0]);
                    } else {
                        // Eğer başlangıç tarihi silinirse kısıtlamayı kaldır
                        endDatePicker.set("minDate", null);
                    }
                }
            });

            // BAŞARI MESAJI (Aynı kaldı)
            var successMessage = '@Html.Raw(TempData["LeaveSuccess"] ?? "")';

            if (successMessage && successMessage !== '') {
                Swal.fire({
                    title: 'Başarılı!',
                    text: successMessage,
                    icon: 'success',
                    confirmButtonText: 'Tamam',
                    confirmButtonColor: '#198754'
                });
            }
        });
    </script>
}