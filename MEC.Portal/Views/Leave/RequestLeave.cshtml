@model MEC.Portal.Models.LeaveRequestViewModel

@{
    ViewData["Title"] = "İzin Talep Formu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-calendar-check"></i> İzin Talep Formu</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        Lütfen izin kullanmak istediğiniz tarih aralığını seçin ve talebinizi iletin.
                    </p>

                    <form asp-action="RequestLeave" method="post">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Başlangıç Tarihi</label>
                                <input asp-for="StartDate" class="form-control datepicker" placeholder="Tarih Seçiniz" required autocomplete="off" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Bitiş Tarihi</label>
                                <input asp-for="EndDate" class="form-control datepicker" placeholder="Tarih Seçiniz" required autocomplete="off" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">İzin Nedeni / Açıklama</label>
                            <textarea asp-for="Reason" class="form-control" rows="4" placeholder="Örn: Yıllık izin, Sağlık sorunu, Özel işlerim vb..." required></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">
                                Talebi Gönder
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>
    <script>
        $(document).ready(function () {
            // "datepicker" class'ına sahip inputları harika bir takvime dönüştürüyoruz
            flatpickr(".datepicker", {
                locale: "tr", // Takvimi Türkçe yap
                dateFormat: "d.m.Y", // Türkiye tarih formatı (Gün.Ay.Yıl)
                minDate: "today", // Geçmiş tarihler seçilemesin
                disable: [
                    function(date) {
                        // (Opsiyonel) Hafta sonlarını (Cumartesi-Pazar) seçime kapatmak istersen bu kodu açabilirsin
                        return (date.getDay() === 0 || date.getDay() === 6);
                    }
                ]
            });
        });
    </script>
}