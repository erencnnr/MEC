@model MEC.Application.Service.LeaveService.AccountPage
@{
    ViewData["SettingsSection"] = "users"; ViewData["Title"] = "İzin hesabı"; Layout = "~/Views/Shared/_SettingsLayout.cshtml"; var id = Model.Employee.Id; }
<link rel="stylesheet" href="~/css/leave-accounting.css" />
<section class="leave-accounting">
<h1>@Model.Employee.FirstName @Model.Employee.LastName · İzin hesabı</h1>
<p>Güncel bakiye: <strong>@Model.Account.Balance.ToString("0.##") gün</strong>. Kalan günler yeni çalışma yılına devreder.</p>
@if (TempData["AccountingMessage"] is string message) { <p role="status">@message</p> }
@if (Model.Account.NeedsReview) { <p role="alert">Açılış bilgileri belirsiz. Hak ediş için tarihli mutabakat gerekiyor.</p> }
<p><a href="/Admin/PortalUsers/@id">Personel bilgileri</a> · <a href="/Admin/LeaveAccounts/Jobs">Job sonuçları</a></p>
<h2>Gerekçeli gün düzeltmesi</h2>
<form method="post" action="/Admin/LeaveAccounts/@id/Manual">
@Html.AntiForgeryToken()
<input type="hidden" name="operationId" value="@Guid.NewGuid()" />
<label>Gün (+ ekleme, − çıkarma)<input name="days" type="number" step="0.01" required /></label>
<label>Gerekçe<input name="reason" maxlength="1000" required /></label><button type="submit">Hareketi kaydet</button>
</form>
<h2>Tarih düzeltmesi</h2>
<form method="post" action="/Admin/LeaveAccounts/@id/PreviewDates">
@Html.AntiForgeryToken()
<label>İşe giriş<input type="date" name="hireDate" value="@Model.Employee.HireDate?.ToString("yyyy-MM-dd")" required /></label>
<label>Doğum tarihi<input type="date" name="birthDate" value="@Model.Employee.BirthDate?.ToString("yyyy-MM-dd")" /></label>
<button type="submit">Bakiye etkisini göster</button>
</form>
@if (Model.Preview is { } preview)
{
    <div role="status">
    <p>Eski giriş: @preview.OldHireDate?.ToString("dd.MM.yyyy") · Yeni giriş: @preview.HireDate.ToString("dd.MM.yyyy")</p>
    @if (preview.RequiresReconciliation) { <p>Eski haklar belirsiz. Aşağıdaki tarihli mutabakat formunda doğru tarih ve bakiyeyi birlikte girin.</p> }
    else {
        <p>Bakiye: @preview.Balance → @(preview.Balance + preview.Difference) gün. Fark: @preview.Difference gün.</p>
        <form method="post" action="/Admin/LeaveAccounts/@id/ApplyDates">
        @Html.AntiForgeryToken()
        <input type="hidden" name="hireDate" value="@preview.HireDate.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="birthDate" value="@preview.BirthDate?.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="token" value="@preview.Token" />
        <label>Gerekçe<input name="reason" required maxlength="1000" /></label><button type="submit">Farkı onayla ve uygula</button>
        </form>
    }
    </div>
}
<h2>Tarihli mutabakat ve yeniden işe giriş</h2>
<p>Bu tarih dahil kalan toplam bakiyeyi girin. Önceki belge saklanır, değişen kayıt yeni imza gerektirir. Sonraki manuel hareketler korunur.</p>
<form method="post" action="/Admin/LeaveAccounts/@id/Reconcile">
@Html.AntiForgeryToken()
<label>Mutabakat tarihi<input name="cutoff" type="date" max="@MEC.Domain.Common.LeaveAccountingRules.Now.ToString("yyyy-MM-dd")" required /></label>
<label>O tarihte kalan gün<input name="balance" type="number" step="0.01" required /></label>
<label>Doğru işe giriş<input name="hireDate" type="date" value="@Model.Employee.HireDate?.ToString("yyyy-MM-dd")" required /></label>
<label>Doğru doğum tarihi<input name="birthDate" type="date" value="@Model.Employee.BirthDate?.ToString("yyyy-MM-dd")" /></label>
<label>Gerekçe<input name="reason" required maxlength="1000" /></label>
@if (Model.Employee.IsDeleted) { <label><input name="reactivate" type="checkbox" value="true" /> Yeni işe girişle aktifleştir</label> }
<button type="submit">Mutabakatı kaydet</button>
</form>
<h2>Hareketler</h2><div class="accounting-table"><table><thead><tr><th>Tarih</th><th>İşlem</th><th>Gün</th><th>Yapan</th><th>Gerekçe</th></tr></thead><tbody>
@foreach (var movement in Model.Movements) { <tr><td>@movement.EffectiveDate.ToString("dd.MM.yyyy")</td><td>@(movement.Kind switch { "Opening"=>"Açılış", "AnnualAccrual"=>"Yıllık hak", "Manual"=>"Manuel düzeltme", "Excel"=>"Excel ekleme", "LeaveUse"=>"İzin kullanımı", "LeaveRefund"=>"İade", "Reconciliation"=>"Mutabakat", "DateCorrection"=>"Tarih düzeltmesi", "PolicyCorrection"=>"Takvim düzeltmesi", "SplitReview"=>"Gün dağılımı", _=>movement.Kind })</td><td>@movement.Days.ToString("0.##")</td><td>@movement.Actor</td><td>@movement.Reason</td></tr> }
</tbody></table></div>
<h2>Önceki mutabakatlar</h2>
@foreach (var version in Model.Versions) { using var snapshot = System.Text.Json.JsonDocument.Parse(version.Snapshot); var old = snapshot.RootElement; <p>Sürüm @version.Version · @version.CreatedDate?.ToString("dd.MM.yyyy HH:mm") · @version.Actor · Bakiye: @old.GetProperty("AgreedLeaveDays").GetDecimal() gün · @(old.GetProperty("IsSigned").GetBoolean() ? "İmzalı" : "İmzasız") @if(old.GetProperty("AgreementPdfFileName").ValueKind==System.Text.Json.JsonValueKind.String){<a href="/Admin/LeaveAccounts/@id/Versions/@version.Id/Pdf">Eski PDF</a>}</p> }
</section>
