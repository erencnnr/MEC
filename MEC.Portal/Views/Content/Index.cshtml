@using System.Linq
@model MEC.Portal.Models.AdminContentManagementViewModel

@{
    ViewData["Title"] = "İçerik Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="library-page library-page--admin">
    <div class="library-shell">
        <div class="library-topbar library-topbar--admin">
            <div>
                <span class="library-topbar__eyebrow">Yönetici işlemleri</span>
                <h1>İçerik Yönetimi</h1>
            </div>

            @if (Model.SelectedFolderId.HasValue)
            {
                <div class="content-management-toolbar">
                    <button type="button"
                            class="library-button library-button--secondary content-management-toolbar__delete-button"
                            data-modal-target="delete-folder-modal">
                        Seçili Klasörü Sil
                    </button>
                    <button type="button"
                            class="library-button library-button--secondary"
                            data-modal-target="new-folder-modal">
                        Yeni Alt Klasör
                    </button>
                    <button type="button"
                            class="library-button library-button--secondary content-management-toolbar__upload-button"
                            data-modal-target="upload-modal">
                        Doküman Ekle
                    </button>
                </div>
            }
        </div>

        @if (TempData["ContentSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="library-alert library-alert--success">@successMessage</div>
        }

        @if (TempData["ContentError"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="library-alert library-alert--error">@errorMessage</div>
        }

        @if (Model.HasFolders)
        {
            <div class="content-management-drag-help">
                <span aria-hidden="true">&#8645;</span>
                <p><strong>S&#252;r&#252;kle-b&#305;rak ile ta&#351;&#305;y&#305;n:</strong> Dosya veya klas&#246;r&#252; tutup hedef klas&#246;r&#252;n &#252;zerine b&#305;rak&#305;n.</p>
            </div>
            <div id="libraryDragStatus" class="library-alert content-management-drag-status" role="status" aria-live="polite" hidden></div>
        }

        <div class="library-layout content-management-layout">
            <aside class="library-sidebar">
                <section class="library-card library-card--sidebar library-explorer">
                    <div class="library-card__head content-management-sidebar-head">
                        <div>
                            <span class="library-card__eyebrow">Klasörler</span>
                            <h2>İçerik ağacı</h2>
                        </div>
                        <button type="button"
                                class="library-button library-button--secondary content-management-root-button"
                                data-modal-target="root-folder-modal">
                            Yeni Ana Klasör
                        </button>
                    </div>

                    @if (Model.FolderTree.Any())
                    {
                        <nav class="library-tree" aria-label="İçerik klasörleri">
                            <ul class="library-tree__group">
                                @foreach (var folder in Model.FolderTree)
                                {
                                    @await Html.PartialAsync("_LibraryTreeNode", folder)
                                }
                            </ul>
                        </nav>
                    }
                    else
                    {
                        <div class="content-management-root">
                            <div class="library-empty library-empty--compact">
                                <h3>Henüz klasör yok</h3>
                                <p>İlk ana klasörü oluşturmak için Yeni Ana Klasör butonunu kullanabilirsiniz.</p>
                            </div>
                        </div>
                    }
                </section>
            </aside>

            <div class="library-main">
                @if (Model.SelectedFolderId.HasValue)
                {
                    <section class="library-card content-management-card"
                             data-library-drop-folder-id="@Model.SelectedFolderId">
                        <div class="library-card__head library-card__head--split">
                            <div>
                                <span class="library-card__eyebrow">Seçili klasör</span>
                                <h2>@Model.SelectedFolderName</h2>
                            </div>

                            @if (Model.Breadcrumbs.Any())
                            {
                                <nav class="library-breadcrumbs" aria-label="Klasör yolu">
                                    @foreach (var crumb in Model.Breadcrumbs)
                                    {
                                        <a href="/Admin/Content?folderId=@crumb.Id">@crumb.Name</a>
                                    }
                                </nav>
                            }
                        </div>

                        @if (Model.Items.Any())
                        {
                            <div class="content-management-grid">
                                @foreach (var item in Model.Items)
                                {
                                    if (item.IsFolder)
                                    {
                                        <a class="content-management-tile content-management-tile--folder"
                                           href="@item.NavigateUrl"
                                           draggable="true"
                                           data-library-drag-type="folder"
                                           data-library-drag-id="@item.FolderId"
                                           data-library-drop-folder-id="@item.FolderId">
                                            <span class="content-management-tile__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" role="presentation">
                                                    <path d="M3 7.5C3 6.67 3.67 6 4.5 6H9l1.4 1.8H19.5c.83 0 1.5.67 1.5 1.5V17c0 .83-.67 1.5-1.5 1.5h-15C3.67 18.5 3 17.83 3 17V7.5Z" fill="currentColor" opacity=".22"></path>
                                                    <path d="M3 8.25C3 7.01 4.01 6 5.25 6H9l1.35 1.5H18.75C19.99 7.5 21 8.51 21 9.75V16.75C21 17.99 19.99 19 18.75 19H5.25C4.01 19 3 17.99 3 16.75V8.25Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                                                </svg>
                                            </span>
                                            <span class="content-management-tile__body">
                                                <strong>@item.Name</strong>
                                                <span>@item.MetaText</span>
                                            </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <article class="@(item.IsSelected ? "content-management-tile content-management-tile--document is-selected" : "content-management-tile content-management-tile--document")"
                                                 draggable="true"
                                                 data-library-drag-type="document"
                                                 data-library-drag-id="@item.DocumentId"
                                                 data-select-url="@item.SelectUrl"
                                                 data-open-url="@item.OpenUrl"
                                                 data-preview-url="@item.PreviewUrl"
                                                 data-is-pdf="@item.IsPdf.ToString().ToLowerInvariant()">
                                            <details class="content-management-menu">
                                                <summary class="content-management-menu__toggle" aria-label="Doküman işlemleri">...</summary>
                                                <div class="content-management-menu__list">
                                                    @if (item.IsPdf)
                                                    {
                                                        <a class="content-management-menu__item" href="@item.SelectUrl">Önizle</a>
                                                        <a class="content-management-menu__item" href="@item.PreviewUrl" target="_blank" rel="noopener noreferrer">Yeni Sekmede Aç</a>
                                                    }
                                                    else
                                                    {
                                                        <a class="content-management-menu__item" href="@item.OpenUrl" target="_blank" rel="noopener noreferrer">Aç</a>
                                                    }

                                                    <a class="content-management-menu__item" href="@item.OpenUrl" target="_blank" rel="noopener noreferrer">İndir</a>
                                                    <button type="button"
                                                            class="content-management-menu__item"
                                                            data-rename-document-id="@item.DocumentId"
                                                            data-rename-document-name="@item.Name">
                                                        Yeniden Adlandır
                                                    </button>

                                                    <form asp-controller="Content" asp-action="DeleteDocument" asp-route-id="@item.DocumentId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit"
                                                                class="content-management-menu__item content-management-menu__item--danger"
                                                                onclick="return confirm('Dokümanı silmek istediğinize emin misiniz?');">
                                                            Sil
                                                        </button>
                                                    </form>
                                                </div>
                                            </details>

                                            <div class="content-management-tile__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" role="presentation">
                                                    <path d="M7 3.75h7.2L19 8.55V19a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 6 19V5.25A1.5 1.5 0 0 1 7.5 3.75Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                                                    <path d="M14 3.75V8.5h4.75" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                                                    <path d="M8.75 14.25h6.5M8.75 17h4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                                                </svg>
                                            </div>
                                            <div class="content-management-tile__body">
                                                <strong>@item.Name</strong>
                                                <span>@item.MetaText</span>
                                            </div>
                                        </article>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="library-empty library-empty--compact">
                                <h3>Bu klasörde içerik yok</h3>
                                <p>Seçili klasöre yeni alt klasör veya doküman ekleyebilirsiniz.</p>
                            </div>
                        }
                    </section>

                    @if (Model.SelectedDocument != null)
                    {
                        <section class="library-card content-management-preview">
                            <div class="library-card__head library-card__head--split">
                                <div>
                                    <span class="library-card__eyebrow">Doküman okuyucu</span>
                                    <h2>@Model.SelectedDocument.OriginalFileName</h2>
                                </div>

                                <div class="content-management-preview__actions">
                                    <a class="library-button library-button--ghost" href="@Model.SelectedDocument.OpenUrl" target="_blank" rel="noopener noreferrer">İndir</a>
                                    @if (Model.SelectedDocument.IsPdf)
                                    {
                                        <a class="library-button library-button--primary" href="@Model.SelectedDocument.PreviewUrl" target="_blank" rel="noopener noreferrer">Yeni Sekmede Aç</a>
                                    }
                                </div>
                            </div>

                            @if (Model.SelectedDocument.IsPdf)
                            {
                                <div class="library-preview content-management-preview__frame">
                                    <iframe src="@Model.SelectedDocument.PreviewUrl" title="@Model.SelectedDocument.OriginalFileName"></iframe>
                                </div>
                            }
                            else
                            {
                                <div class="library-empty library-empty--compact">
                                    <h3>Sayfa içi önizleme yalnızca PDF için aktif</h3>
                                    <p>Bu dosyayı yeni sekmede açabilir veya indirebilirsiniz.</p>
                                </div>
                            }
                        </section>
                    }
                }
                else
                {
                    <section class="library-card">
                        <div class="library-empty">
                            <h2>Başlamak için bir klasör seçin</h2>
                            <p>Soldan bir klasör seçtikten sonra bu alanda alt klasör ve doküman yönetimini yapabilirsiniz.</p>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>

    <div id="root-folder-modal" class="content-management-modal" aria-hidden="true">
        <div class="content-management-modal__backdrop" data-modal-close></div>
        <div class="content-management-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="rootFolderModalTitle">
            <button type="button" class="content-management-modal__close" data-modal-close aria-label="Pencereyi kapat">×</button>
            <div class="content-management-modal__head">
                <span class="library-card__eyebrow">Yeni ana klasör</span>
                <h3 id="rootFolderModalTitle">Ana klasör oluştur</h3>
                <p>Kütüphane ağacının en üst seviyesine yeni bir klasör ekleyin.</p>
            </div>
            <form asp-controller="Content" asp-action="CreateFolder" method="post" class="content-management-modal__form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="parentFolderId" value="" />
                <label class="library-form__label" for="rootFolderName">Klasör adı</label>
                <input id="rootFolderName" class="library-input" type="text" name="name" maxlength="120" placeholder="Ana klasör adı" />
                <div class="content-management-modal__actions">
                    <button type="button" class="library-button library-button--ghost" data-modal-close>Vazgeç</button>
                    <button type="submit" class="library-button library-button--primary">Ekle</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.SelectedFolderId.HasValue)
    {
        <div id="delete-folder-modal" class="content-management-modal" aria-hidden="true">
            <div class="content-management-modal__backdrop" data-modal-close></div>
            <div class="content-management-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="deleteFolderModalTitle">
                <button type="button" class="content-management-modal__close" data-modal-close aria-label="Pencereyi kapat">×</button>
                <div class="content-management-modal__head">
                    <span class="library-card__eyebrow content-management-modal__eyebrow--danger">Klasör silme</span>
                    <h3 id="deleteFolderModalTitle">@Model.SelectedFolderName klasörünü sil</h3>
                    <p>Bu işlemi gerçekleştirirseniz doküman ve alt klasörler de seçtiğiniz klasör ile beraber silinecektir.</p>
                </div>
                <form asp-controller="Content" asp-action="DeleteFolder" asp-route-id="@Model.SelectedFolderId.Value" method="post" class="content-management-modal__form">
                    @Html.AntiForgeryToken()
                    <div class="content-management-modal__actions">
                        <button type="button" class="library-button library-button--ghost" data-modal-close>İptal</button>
                        <button type="submit" class="library-button library-button--danger">Sil</button>
                    </div>
                </form>
            </div>
        </div>

        <div id="new-folder-modal" class="content-management-modal" aria-hidden="true">
            <div class="content-management-modal__backdrop" data-modal-close></div>
            <div class="content-management-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="newFolderModalTitle">
                <button type="button" class="content-management-modal__close" data-modal-close aria-label="Pencereyi kapat">×</button>
                <div class="content-management-modal__head">
                    <span class="library-card__eyebrow">Yeni alt klasör</span>
                    <h3 id="newFolderModalTitle">Seçili klasöre alt klasör ekle</h3>
                    <p>@Model.SelectedFolderName klasörünün içine yeni bir alt klasör oluşturun.</p>
                </div>
                <form asp-controller="Content" asp-action="CreateFolder" method="post" class="content-management-modal__form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="parentFolderId" value="@Model.SelectedFolderId" />
                    <label class="library-form__label" for="childFolderName">Klasör adı</label>
                    <input id="childFolderName" class="library-input" type="text" name="name" maxlength="120" placeholder="Alt klasör adı" />
                    <div class="content-management-modal__actions">
                        <button type="button" class="library-button library-button--ghost" data-modal-close>Vazgeç</button>
                        <button type="submit" class="library-button library-button--primary">Ekle</button>
                    </div>
                </form>
            </div>
        </div>

        <div id="upload-modal" class="content-management-modal" aria-hidden="true">
            <div class="content-management-modal__backdrop" data-modal-close></div>
            <div class="content-management-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="uploadModalTitle">
                <button type="button" class="content-management-modal__close" data-modal-close aria-label="Pencereyi kapat">×</button>
                <div class="content-management-modal__head">
                    <span class="library-card__eyebrow">Doküman ekle</span>
                    <h3 id="uploadModalTitle">Seçili klasöre dosya yükle</h3>
                    <p>PDF ve desteklenen ofis dokümanlarını @Model.SelectedFolderName klasörüne yükleyin.</p>
                </div>
                <form asp-controller="Content" asp-action="UploadDocuments" method="post" enctype="multipart/form-data" class="content-management-modal__form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="folderId" value="@Model.SelectedFolderId" />
                    <label class="library-form__label" for="libraryFiles">Doküman seçin</label>
                    <input id="libraryFiles" class="library-input library-input--file" type="file" name="files" multiple accept=".pdf,.jpg,.jpeg,.png,.gif,.txt,.doc,.docx,.xls,.xlsx" />
                    <div class="content-management-modal__actions">
                        <button type="button" class="library-button library-button--ghost" data-modal-close>Vazgeç</button>
                        <button type="submit" class="library-button library-button--primary">Yükle</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <form id="renameDocumentForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input id="renameDocumentName" name="name" type="hidden" />
    </form>

    <form id="libraryMoveForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>
</section>

@section Scripts {
    <script>
        (function () {
            var body = document.body;

            function closeAllModals() {
                document.querySelectorAll(".content-management-modal.is-visible").forEach(function (modal) {
                    modal.classList.remove("is-visible");
                    modal.setAttribute("aria-hidden", "true");
                });
                body.classList.remove("content-management-modal-open");
            }

            document.querySelectorAll("[data-modal-target]").forEach(function (button) {
                button.addEventListener("click", function () {
                    var modalId = button.getAttribute("data-modal-target");
                    var modal = modalId ? document.getElementById(modalId) : null;
                    if (!modal) {
                        return;
                    }

                    closeAllModals();
                    modal.classList.add("is-visible");
                    modal.setAttribute("aria-hidden", "false");
                    body.classList.add("content-management-modal-open");

                    var firstInput = modal.querySelector("input:not([type='hidden'])");
                    if (firstInput) {
                        window.setTimeout(function () { firstInput.focus(); }, 40);
                    }
                });
            });

            document.querySelectorAll("[data-modal-close]").forEach(function (element) {
                element.addEventListener("click", function () {
                    closeAllModals();
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    closeAllModals();
                }
            });

            document.querySelectorAll(".content-management-tile--document").forEach(function (tile) {
                tile.addEventListener("dblclick", function (event) {
                    if (event.target.closest(".content-management-menu")) {
                        return;
                    }

                    var isPdf = tile.getAttribute("data-is-pdf") === "true";
                    if (isPdf) {
                        var selectUrl = tile.getAttribute("data-select-url");
                        if (selectUrl) {
                            window.location.href = selectUrl;
                        }
                        return;
                    }

                    var openUrl = tile.getAttribute("data-open-url");
                    if (openUrl) {
                        window.open(openUrl, "_blank", "noopener");
                    }
                });
            });

            document.querySelectorAll("[data-rename-document-id]").forEach(function (button) {
                button.addEventListener("click", function () {
                    var documentId = button.getAttribute("data-rename-document-id");
                    var currentName = button.getAttribute("data-rename-document-name") || "";
                    var newName = window.prompt("Yeni doküman adını girin", currentName);
                    if (!newName) {
                        return;
                    }

                    var form = document.getElementById("renameDocumentForm");
                    var input = document.getElementById("renameDocumentName");
                    if (!form || !input || !documentId) {
                        return;
                    }

                    input.value = newName;
                    form.action = "/Admin/Content/RenameDocument/" + documentId;
                    form.submit();
                });
            });

            var draggedLibraryItem = null;
            var draggedLibraryElement = null;
            var activeDropTarget = null;
            var dragStatus = document.getElementById("libraryDragStatus");

            function clearLibraryDragState() {
                if (draggedLibraryElement) {
                    draggedLibraryElement.classList.remove("is-dragging");
                }
                if (activeDropTarget) {
                    activeDropTarget.classList.remove("is-drop-target");
                }

                document.querySelectorAll(".is-drop-loading").forEach(function (element) {
                    element.classList.remove("is-drop-loading");
                });

                draggedLibraryItem = null;
                draggedLibraryElement = null;
                activeDropTarget = null;
            }

            function showLibraryDragStatus(message, isError) {
                if (!dragStatus) {
                    if (isError) {
                        window.alert(message);
                    }
                    return;
                }

                dragStatus.textContent = message;
                dragStatus.hidden = false;
                dragStatus.classList.toggle("library-alert--error", isError);
                dragStatus.classList.toggle("library-alert--success", !isError);
            }

            function getDropTarget(eventTarget) {
                return eventTarget instanceof Element
                    ? eventTarget.closest("[data-library-drop-folder-id]")
                    : null;
            }

            function canDropOn(target) {
                if (!draggedLibraryItem || !target) {
                    return false;
                }

                var targetFolderId = target.getAttribute("data-library-drop-folder-id");
                return !!targetFolderId &&
                    !(draggedLibraryItem.type === "folder" && draggedLibraryItem.id === targetFolderId);
            }

            document.addEventListener("dragstart", function (event) {
                var source = event.target instanceof Element
                    ? event.target.closest("[data-library-drag-type]")
                    : null;

                if (!source || event.target.closest(".content-management-menu")) {
                    event.preventDefault();
                    return;
                }

                var itemType = source.getAttribute("data-library-drag-type");
                var itemId = source.getAttribute("data-library-drag-id");
                if (!itemType || !itemId || !event.dataTransfer) {
                    event.preventDefault();
                    return;
                }

                draggedLibraryItem = { type: itemType, id: itemId };
                draggedLibraryElement = source;
                source.classList.add("is-dragging");
                event.dataTransfer.effectAllowed = "move";
                event.dataTransfer.setData("text/plain", itemType + ":" + itemId);
            });

            document.addEventListener("dragover", function (event) {
                var target = getDropTarget(event.target);
                if (!canDropOn(target)) {
                    if (activeDropTarget) {
                        activeDropTarget.classList.remove("is-drop-target");
                        activeDropTarget = null;
                    }
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                if (event.dataTransfer) {
                    event.dataTransfer.dropEffect = "move";
                }

                if (activeDropTarget !== target) {
                    if (activeDropTarget) {
                        activeDropTarget.classList.remove("is-drop-target");
                    }
                    activeDropTarget = target;
                    activeDropTarget.classList.add("is-drop-target");
                }
            });

            document.addEventListener("drop", async function (event) {
                var target = getDropTarget(event.target);
                if (!canDropOn(target)) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();

                var item = draggedLibraryItem;
                var targetFolderId = target.getAttribute("data-library-drop-folder-id");
                var tokenInput = document.querySelector("#libraryMoveForm input[name='__RequestVerificationToken']");
                if (!item || !targetFolderId || !tokenInput) {
                    clearLibraryDragState();
                    showLibraryDragStatus("Taşıma işlemi başlatılamadı. Sayfayı yenileyip tekrar deneyin.", true);
                    return;
                }

                target.classList.add("is-drop-loading");
                showLibraryDragStatus("İçerik taşınıyor...", false);

                var formData = new URLSearchParams();
                formData.append("__RequestVerificationToken", tokenInput.value);
                formData.append("ItemType", item.type);
                formData.append("ItemId", item.id);
                formData.append("TargetFolderId", targetFolderId);

                try {
                    var response = await fetch("/Admin/Content/MoveItem", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: formData.toString()
                    });
                    var payload = await response.json();
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.message || "İçerik taşınamadı.");
                    }

                    showLibraryDragStatus(payload.message || "İçerik taşındı.", false);
                    window.setTimeout(function () {
                        window.location.href = payload.redirectUrl || ("/Admin/Content?folderId=" + targetFolderId);
                    }, 350);
                } catch (error) {
                    clearLibraryDragState();
                    showLibraryDragStatus(error instanceof Error ? error.message : "İçerik taşınamadı.", true);
                }
            });

            document.addEventListener("dragend", function () {
                clearLibraryDragState();
            });
        })();
    </script>
}
