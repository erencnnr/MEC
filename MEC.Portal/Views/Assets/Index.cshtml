@using MEC.Application.Abstractions.Service.AssetService.Model
@using MEC.Domain.Common
@using MEC.Portal.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResult<AssetListViewModel>

@{
    ViewData["Title"] = "Envanter";
    var filter = ViewBag.CurrentFilters as AssetFilterRequestModel;
    var hasFilter = filter != null &&
        (!string.IsNullOrWhiteSpace(filter.SearchText) ||
         (filter.SchoolIds?.Any() ?? false) ||
         (filter.AssetTypeIds?.Any() ?? false) ||
         (filter.AssetStatusIds?.Any() ?? false) ||
         !string.IsNullOrWhiteSpace(filter.SortOrder));
}

<section class="inventory-page">
    <div class="inventory-page__header">
        <div>
            <span class="inventory-page__eyebrow">YÖNETİCİ İŞLEMLERİ</span>
            <h1 class="inventory-page__title">Envanter</h1>
            <p class="inventory-page__subtitle">Varlıkları filtreleyin, detaylarını inceleyin ve teknik kayıtlarını tek ekrandan yönetin.</p>
        </div>
        <div class="inventory-page__actions">
            <a asp-action="Create" asp-controller="Assets" class="inventory-button inventory-button--primary">Yeni Envanter</a>
            <button type="button" class="inventory-button inventory-button--success" onclick="exportAssets()">Excel'e Aktar</button>
        </div>
    </div>

    <form method="get" asp-action="Index" asp-controller="Assets" id="assetFilterForm">
        <input type="hidden" name="Page" id="currentPageInput" value="@Model.CurrentPage" />
        <input type="hidden" name="SortOrder" id="sortOrderInput" value="@ViewBag.CurrentSort" />

        <div class="inventory-table-card">
            <div class="inventory-table-card__meta">
                <span>@Model.RowCount kayıt</span>
                <div class="inventory-table-card__meta-actions">
                    <div class="inventory-search inventory-search--compact">
                        <input type="text" name="SearchText" value="@filter?.SearchText" class="inventory-search__input" placeholder="Personel, Eşya, Seri No..." />
                        <button type="submit" class="inventory-search__button inventory-search__button--icon" onclick="resetPage()" aria-label="Ara">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M10.5 4.5C7.18629 4.5 4.5 7.18629 4.5 10.5C4.5 13.8137 7.18629 16.5 10.5 16.5C13.8137 16.5 16.5 13.8137 16.5 10.5C16.5 7.18629 13.8137 4.5 10.5 4.5Z" stroke="currentColor" stroke-width="2" />
                                <path d="M15.25 15.25L19.5 19.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </button>
                    </div>
                    <span>Sayfa @Model.CurrentPage / @Math.Max(Model.PageCount, 1)</span>
                    @if (hasFilter)
                    {
                        <a asp-action="Index" asp-controller="Assets" class="inventory-button inventory-button--ghost inventory-button--small">Temizle</a>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table inventory-table mb-0">
                    <thead>
                        <tr>
                            <th>Seri No</th>
                            <th>Ad</th>
                            <th>
                                <div class="inventory-table__header-filter">
                                    <span>Tür</span>
                                    <div class="dropdown" data-bs-auto-close="outside">
                                        <button class="inventory-table__filter-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="inventory-table__filter-icon @(filter?.AssetTypeIds?.Any() == true ? "is-active" : string.Empty)" aria-hidden="true">
                                                <svg viewBox="0 0 16 16" fill="none">
                                                    <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </span>
                                        </button>
                                        <div class="dropdown-menu inventory-table__filter-menu">
                                            <span class="inventory-table__filter-label">Tür filtresi</span>
                                            <div class="inventory-checkbox-list">
                                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Types)
                                                {
                                                    var isChecked = filter?.AssetTypeIds?.Contains(int.Parse(item.Value)) ?? false;
                                                    <div class="inventory-checkbox-chip inventory-checkbox-chip--interactive" data-filter-item tabindex="0">
                                                        <input type="checkbox" name="AssetTypeIds" value="@item.Value" @(isChecked ? "checked" : null) />
                                                        <span>@item.Text</span>
                                                    </div>
                                                }
                                            </div>
                                            <button type="submit" class="inventory-button inventory-button--primary inventory-button--small" onclick="resetPage()">Uygula</button>
                                        </div>
                                    </div>
                                </div>
                            </th>
                            <th>Açıklama</th>
                            <th>
                                <div class="inventory-table__header-filter">
                                    <span>Konum / Okul</span>
                                    <div class="dropdown" data-bs-auto-close="outside">
                                        <button class="inventory-table__filter-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="inventory-table__filter-icon @(filter?.SchoolIds?.Any() == true ? "is-active" : string.Empty)" aria-hidden="true">
                                                <svg viewBox="0 0 16 16" fill="none">
                                                    <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </span>
                                        </button>
                                        <div class="dropdown-menu inventory-table__filter-menu">
                                            <span class="inventory-table__filter-label">Okul filtresi</span>
                                            <div class="inventory-checkbox-list">
                                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Schools)
                                                {
                                                    var isChecked = filter?.SchoolIds?.Contains(int.Parse(item.Value)) ?? false;
                                                    <div class="inventory-checkbox-chip inventory-checkbox-chip--interactive" data-filter-item tabindex="0">
                                                        <input type="checkbox" name="SchoolIds" value="@item.Value" @(isChecked ? "checked" : null) />
                                                        <span>@item.Text</span>
                                                    </div>
                                                }
                                            </div>
                                            <button type="submit" class="inventory-button inventory-button--primary inventory-button--small" onclick="resetPage()">Uygula</button>
                                        </div>
                                    </div>
                                </div>
                            </th>
                            <th>
                                <div class="inventory-table__header-filter">
                                    <span>Durum</span>
                                    <div class="dropdown" data-bs-auto-close="outside">
                                        <button class="inventory-table__filter-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="inventory-table__filter-icon @(filter?.AssetStatusIds?.Any() == true ? "is-active" : string.Empty)" aria-hidden="true">
                                                <svg viewBox="0 0 16 16" fill="none">
                                                    <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </span>
                                        </button>
                                        <div class="dropdown-menu inventory-table__filter-menu">
                                            <span class="inventory-table__filter-label">Durum filtresi</span>
                                            <div class="inventory-checkbox-list">
                                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Statuses)
                                                {
                                                    var isChecked = filter?.AssetStatusIds?.Contains(int.Parse(item.Value)) ?? false;
                                                    <div class="inventory-checkbox-chip inventory-checkbox-chip--interactive" data-filter-item tabindex="0">
                                                        <input type="checkbox" name="AssetStatusIds" value="@item.Value" @(isChecked ? "checked" : null) />
                                                        <span>@item.Text</span>
                                                    </div>
                                                }
                                            </div>
                                            <button type="submit" class="inventory-button inventory-button--primary inventory-button--small" onclick="resetPage()">Uygula</button>
                                        </div>
                                    </div>
                                </div>
                            </th>
                            <th>
                                <div class="inventory-table__header-filter">
                                    <span>Kayıt Tarihi</span>
                                    <div class="dropdown" data-bs-auto-close="outside">
                                        <button class="inventory-table__filter-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="inventory-table__filter-icon @(!string.IsNullOrWhiteSpace((string?)ViewBag.CurrentSort) ? "is-active" : string.Empty)" aria-hidden="true">
                                                <svg viewBox="0 0 16 16" fill="none">
                                                    <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </span>
                                        </button>
                                        <div class="dropdown-menu inventory-table__filter-menu inventory-table__filter-menu--compact">
                                            <button type="button" class="inventory-dropdown-action @(ViewBag.CurrentSort == "Date_Desc" ? "is-active" : string.Empty)" onclick="changeSort('Date_Desc')">Yeniden Eskiye</button>
                                            <button type="button" class="inventory-dropdown-action @(ViewBag.CurrentSort == "Date_Asc" ? "is-active" : string.Empty)" onclick="changeSort('Date_Asc')">Eskiden Yeniye</button>
                                            <button type="button" class="inventory-dropdown-action @(string.IsNullOrWhiteSpace((string?)ViewBag.CurrentSort) ? "is-active" : string.Empty)" onclick="changeSort('')">Varsayılan</button>
                                        </div>
                                    </div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Results.Any())
                        {
                            foreach (var item in Model.Results)
                            {
                                <tr class="inventory-table__row" onclick="location.href='@Url.Action("AssetInfo", "Assets", new { id = item.Id })'">
                                    <td>@item.SerialNumber</td>
                                    <td>@item.Name</td>
                                    <td>@item.AssetTypeName</td>
                                    <td>@item.Description</td>
                                    <td>
                                        <div>@item.SchoolName</div>
                                        @if (!string.IsNullOrWhiteSpace(item.SchoolClassName) && item.SchoolClassName != "-")
                                        {
                                            <small>@item.SchoolClassName</small>
                                        }
                                    </td>
                                    <td><span class="inventory-status inventory-status--@item.StatusColor.ToLowerInvariant()">@item.StatusName</span></td>
                                    <td>@item.CreatedDate</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="inventory-table__empty">Kayıt bulunamadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="inventory-pagination" aria-label="Envanter sayfalama">
                <button type="button" class="inventory-pagination__button" onclick="changePage(@(Model.CurrentPage - 1))" disabled="@(Model.CurrentPage == 1 ? "disabled" : null)">Önceki</button>
                @for (var i = 1; i <= Model.PageCount; i++)
                {
                    <button type="button" class="inventory-pagination__button @(i == Model.CurrentPage ? "is-active" : string.Empty)" onclick="changePage(@i)">@i</button>
                }
                <button type="button" class="inventory-pagination__button" onclick="changePage(@(Model.CurrentPage + 1))" disabled="@(Model.CurrentPage == Model.PageCount ? "disabled" : null)">Sonraki</button>
            </nav>
        }
    </form>
</section>

@section Scripts {
    <script>
        function changePage(page) {
            if (page < 1) {
                return;
            }

            document.getElementById('currentPageInput').value = page;
            document.getElementById('assetFilterForm').submit();
        }

        function resetPage() {
            document.getElementById('currentPageInput').value = 1;
        }

        function changeSort(sortOrder) {
            document.getElementById('sortOrderInput').value = sortOrder;
            resetPage();
            document.getElementById('assetFilterForm').submit();
        }

        function exportAssets() {
            const form = document.getElementById('assetFilterForm');
            const params = new URLSearchParams(new FormData(form));
            window.location.href = '@Url.Action("ExportToExcel", "Assets")' + '?' + params.toString();
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.inventory-table__filter-menu').forEach(function (menu) {
                ['pointerdown', 'mousedown', 'mouseup', 'click'].forEach(function (eventName) {
                    menu.addEventListener(eventName, function (event) {
                        event.stopPropagation();
                    });
                });

                menu.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
                    ['pointerdown', 'mousedown', 'mouseup', 'click'].forEach(function (eventName) {
                        checkbox.addEventListener(eventName, function (event) {
                            event.stopPropagation();
                        });
                    });
                });

                menu.querySelectorAll('[data-filter-item]').forEach(function (item) {
                    item.addEventListener('click', function (event) {
                        event.stopPropagation();

                        const checkbox = item.querySelector('input[type="checkbox"]');
                        if (!checkbox || event.target === checkbox) {
                            return;
                        }

                        event.preventDefault();
                        checkbox.checked = !checkbox.checked;
                        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
                    });

                    item.addEventListener('keydown', function (event) {
                        if (event.key !== 'Enter' && event.key !== ' ') {
                            return;
                        }

                        const checkbox = item.querySelector('input[type="checkbox"]');
                        if (!checkbox) {
                            return;
                        }

                        event.preventDefault();
                        event.stopPropagation();
                        checkbox.checked = !checkbox.checked;
                        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
                    });
                });
            });
        });
    </script>
}
