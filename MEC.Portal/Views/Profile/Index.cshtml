@using MEC.Domain.Common.Enum
@using System.Globalization
@model MEC.Portal.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profilim";
    const decimal annualLeaveAllowance = 14m;
    var profile = Model?.Profile;
    var pendingAnnualLeaveCount = Model?.PendingAnnualLeaveCount ?? 0;
    var pendingAnnualLeaveDays = Model?.PendingAnnualLeaveDays ?? 0m;
    var locationNames = profile?.EmployeePortalLocations
        .Select(x => x.Location?.Name ?? string.Empty)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList() ?? new List<string>();
    var fullName = profile == null ? "Kullanıcı" : $"{profile.FirstName} {profile.LastName}".Trim();

    string FormatLeaveDays(decimal value)
    {
        return value.ToString("0.##", CultureInfo.GetCultureInfo("tr-TR"));
    }

    string GetMaritalStatusLabel(MaritalStatusType? status)
    {
        return status switch
        {
            MaritalStatusType.Single => "Bekar",
            MaritalStatusType.Married => "Evli",
            _ => "-"
        };
    }

    string GetChildGenderLabel(ChildGenderType gender)
    {
        return gender == ChildGenderType.Female ? "Kız" : "Erkek";
    }

    string GetChildEducationStatusLabel(ChildEducationStatusType? status)
    {
        return status switch
        {
            ChildEducationStatusType.NotInEducation => "Eğitim Almıyor",
            ChildEducationStatusType.Preschool => "Okul Öncesi",
            ChildEducationStatusType.PrimarySchool => "İlkokul",
            ChildEducationStatusType.MiddleSchool => "Ortaokul",
            ChildEducationStatusType.HighSchool => "Lise",
            ChildEducationStatusType.AssociateDegree => "Ön Lisans",
            ChildEducationStatusType.Undergraduate => "Lisans",
            ChildEducationStatusType.Graduate => "Yüksek Lisans",
            ChildEducationStatusType.Doctorate => "Doktora",
            ChildEducationStatusType.Graduated => "Mezun",
            _ => "Eğitim durumu belirtilmemiş"
        };
    }
}

<section class="profile-page">
    <div class="profile-shell">
        @if (profile == null)
        {
            <div class="profile-empty">
                <span class="profile-empty__eyebrow">Profil</span>
                <h1>Profil bilgileri gösterilemiyor</h1>
                <p>@ViewBag.Error</p>
                <a asp-controller="Home" asp-action="Index" class="profile-empty__action">Ana Sayfaya Dön</a>
            </div>
        }
        else
        {
            <div class="profile-hero">
                <div class="profile-hero__copy">
                    <span class="profile-hero__eyebrow">Çalışan profili</span>
                    <h1>@fullName</h1>
                    <p>Kişisel bilgileriniz ve izin özetiniz bu alanda güncel olarak görüntülenir.</p>
                </div>

                <div class="profile-hero__actions">
                    <a asp-controller="Profile" asp-action="Edit" class="profile-hero__action profile-hero__action--edit">Bilgilerimi Güncelle</a>
                    <a asp-controller="Leave" asp-action="RequestLeave" class="profile-hero__action profile-hero__action--secondary">İzin Talebi Oluştur</a>
                    <a asp-controller="Leave" asp-action="History" class="profile-hero__action profile-hero__action--history">İzin Geçmişim</a>
                </div>
            </div>

            @if (TempData["ProfileSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="profile-alert">
                    <div>
                        <strong>@successMessage</strong>
                    </div>
                </div>
            }

            @if (pendingAnnualLeaveCount > 0)
            {
                <div class="profile-alert">
                    <div>
                        <strong>Bekleyen yıllık izin talebiniz bulunuyor.</strong>
                        <p>Yönetici onayı bekleyen taleplerinizi izin geçmişi ekranından takip edebilirsiniz.</p>
                    </div>
                    <span>@pendingAnnualLeaveCount Talep / @FormatLeaveDays(pendingAnnualLeaveDays) Gün</span>
                </div>
            }

            <div class="profile-card-stack">
                <div class="profile-card">
                    <div class="profile-card__header">
                        <span class="profile-card__eyebrow">Bilgiler</span>
                        <h2>Kullanıcı Bilgileri</h2>
                    </div>

                    <div class="profile-grid">
                        <div class="profile-field">
                            <span>Ad Soyad</span>
                            <strong>@fullName</strong>
                        </div>

                        <div class="profile-field">
                            <span>E-Posta</span>
                            <strong>@profile.Email</strong>
                        </div>

                        <div class="profile-field">
                            <span>Telefon</span>
                            <strong>@(!string.IsNullOrWhiteSpace(profile.PhoneNumber) ? profile.PhoneNumber : "-")</strong>
                        </div>

                        <div class="profile-field">
                            <span>Ünvan</span>
                            <strong>@(!string.IsNullOrWhiteSpace(profile.Title) ? profile.Title : "-")</strong>
                        </div>

                        <div class="profile-field">
                            <span>Lokasyon</span>
                            <strong>@(locationNames.Any() ? string.Join(", ", locationNames) : "-")</strong>
                        </div>

                        <div class="profile-field">
                            <span>İşe Giriş Tarihi</span>
                            <strong>@(profile.HireDate.HasValue && profile.HireDate.Value.Year > 1000 ? profile.HireDate.Value.ToString("dd.MM.yyyy") : "Belirsiz")</strong>
                        </div>

                        <div class="profile-field">
                            <span>Doğum Tarihi</span>
                            <strong>@(profile.BirthDate.HasValue && profile.BirthDate.Value.Year > 1000 ? profile.BirthDate.Value.ToString("dd.MM.yyyy") : "Belirsiz")</strong>
                        </div>

                        <div class="profile-field">
                            <span>Durum</span>
                            <strong>Aktif Çalışan</strong>
                        </div>

                        <div class="profile-field">
                            <span>Yıllık İzin Hakkı</span>
                            <strong>@FormatLeaveDays(annualLeaveAllowance) Gün</strong>
                        </div>

                        <div class="profile-field">
                            <span>Kalan İzin</span>
                            <strong>@FormatLeaveDays(profile.LeaveDays) Gün</strong>
                        </div>
                    </div>
                </div>

                <div class="profile-card">
                    <div class="profile-card__header">
                        <span class="profile-card__eyebrow">Kişisel</span>
                        <h2>Ek Bilgiler</h2>
                    </div>

                    <div class="profile-grid">
                        <div class="profile-field">
                            <span>Adres</span>
                            <strong>@(!string.IsNullOrWhiteSpace(profile.AddressText) ? profile.AddressText : "-")</strong>
                        </div>

                        <div class="profile-field">
                            <span>Medeni Durum</span>
                            <strong>@GetMaritalStatusLabel(profile.MaritalStatus)</strong>
                        </div>

                        <div class="profile-field">
                            <span>Üniversite</span>
                            <strong>@(!string.IsNullOrWhiteSpace(profile.EducationUniversity) ? profile.EducationUniversity : "-")</strong>
                        </div>

                        <div class="profile-field">
                            <span>Fakülte</span>
                            <strong>@(!string.IsNullOrWhiteSpace(profile.EducationFaculty) ? profile.EducationFaculty : "-")</strong>
                        </div>

                        <div class="profile-field">
                            <span>Bölüm</span>
                            <strong>@(!string.IsNullOrWhiteSpace(profile.EducationDepartment) ? profile.EducationDepartment : "-")</strong>
                        </div>
                    </div>
                </div>

                <div class="profile-card">
                    <div class="profile-card__header">
                        <span class="profile-card__eyebrow">Aile</span>
                        <h2>Çocuk Bilgileri</h2>
                    </div>

                    @if (profile.Children.Any())
                    {
                        <div class="profile-child-list">
                            @foreach (var child in profile.Children.OrderBy(x => x.BirthDate))
                            {
                                <div class="profile-child-summary">
                                    <strong>@(!string.IsNullOrWhiteSpace(child.Name) ? child.Name : "Ad belirtilmemiş")</strong>
                                    <span>@GetChildGenderLabel(child.Gender) / @child.BirthDate.ToString("dd.MM.yyyy") / @GetChildEducationStatusLabel(child.EducationStatus)</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="profile-card__empty">Henüz çocuk bilgisi eklenmemiş.</p>
                    }
                </div>
            </div>
        }
    </div>
</section>
