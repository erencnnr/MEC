@model MEC.Portal.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profilim";
    const int annualLeaveAllowance = 14;
    var profile = Model?.Profile;
    var usedLeaveDays = profile == null ? 0 : annualLeaveAllowance - profile.LeaveDays;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0 fw-bold">Profil Bilgilerim</h3>
                </div>

                <div class="card-body p-5">
                    @if (profile == null)
                    {
                        <div class="alert alert-warning">
                            @ViewBag.Error
                        </div>
                    }
                    else
                    {
                        @if (Model.PendingAnnualLeaveCount > 0)
                        {
                            <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">
                                <div>
                                    <strong>Bekleyen yıllık izin talebiniz var.</strong>
                                    Admin onayı bekleniyor.
                                </div>
                                <span class="badge bg-dark">@Model.PendingAnnualLeaveCount Talep / @Model.PendingAnnualLeaveDays Gün</span>
                            </div>
                        }

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted fw-bold">Ad Soyad:</div>
                            <div class="col-sm-8 border-bottom pb-1">@profile.FirstName @profile.LastName</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted fw-bold">E-Posta:</div>
                            <div class="col-sm-8 border-bottom pb-1">@profile.Email</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted fw-bold">Telefon:</div>
                            <div class="col-sm-8 border-bottom pb-1">@profile.PhoneNumber</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted fw-bold">İşe Giriş Tarihi:</div>
                            <div class="col-sm-8 border-bottom pb-1">@profile.HireDate.ToString("dd MMMM yyyy")</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted fw-bold">Doğum Tarihi:</div>
                            <div class="col-sm-8 border-bottom pb-1">@profile.BirthDate.ToString("dd MMMM yyyy")</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted fw-bold">Yıllık İzin Hakkı:</div>
                            <div class="col-sm-8 border-bottom pb-1">14 Gün</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted fw-bold">Kullanılan Yıllık İzin:</div>
                            <div class="col-sm-8">
                                <span class="badge bg-secondary fs-6 px-3 py-2">@usedLeaveDays Gün</span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted fw-bold">Kalan İzin Hakkı:</div>
                            <div class="col-sm-8">
                                <span class="badge @(profile.LeaveDays < 0 ? "bg-danger" : "bg-success") fs-6 px-3 py-2">@profile.LeaveDays Gün</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Ana Sayfaya Dön</a>
                </div>
            </div>
        </div>
    </div>
</div>
