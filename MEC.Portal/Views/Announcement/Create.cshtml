@model MEC.Portal.Models.AnnouncementFormViewModel

@{
    ViewData["Title"] = Model.PageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="announcement-form-page">
    <div class="announcement-form-shell">
        <div class="announcement-form-header">
            <div class="announcement-form-header__copy">
                <span class="announcement-form-header__eyebrow">@Model.Eyebrow</span>
                <h1>@Model.PageTitle</h1>
                <p>@Model.Description</p>
            </div>
        </div>

        @if (TempData["AnnouncementError"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="announcement-form-alert announcement-form-alert--error">@errorMessage</div>
        }

        <div class="announcement-form-card">
            <form asp-action="Create" method="post" enctype="multipart/form-data" class="announcement-form">
                <div asp-validation-summary="ModelOnly" class="announcement-form-alert announcement-form-alert--error"></div>

                <div class="announcement-form-grid">
                    <div class="announcement-form-field announcement-form-field--full">
                        <label asp-for="Title">@Model.TitleLabel</label>
                        <input asp-for="Title" class="announcement-form-input" placeholder="@Model.TitlePlaceholder" required />
                        <span asp-validation-for="Title" class="announcement-form-validation"></span>
                    </div>

                    <div class="announcement-form-field announcement-form-field--full">
                        <label asp-for="Content">@Model.ContentLabel</label>
                        <textarea asp-for="Content" id="summernote" class="announcement-form-input announcement-form-input--editor" required></textarea>
                        <span asp-validation-for="Content" class="announcement-form-validation"></span>
                    </div>

                    <div class="announcement-form-field announcement-form-field--full">
                        <div class="announcement-form-toggle">
                            <span class="announcement-form-toggle__label">Aktiflik durumu</span>

                            <div class="announcement-form-switch-wrap">
                                <span class="announcement-form-switch__state">Pasif</span>
                                <input asp-for="IsActive" id="announcementIsActive" class="announcement-form-switch__input" type="checkbox" checked="checked" />
                                <label for="announcementIsActive" class="announcement-form-switch__control" aria-label="Aktiflik durumunu degistir">
                                    <span class="announcement-form-switch__thumb"></span>
                                </label>
                                <span class="announcement-form-switch__state announcement-form-switch__state--active">Aktif</span>
                            </div>
                        </div>
                    </div>

                    <div class="announcement-form-field announcement-form-field--full">
                        <label asp-for="AttachmentFiles">@Model.AttachmentLabel</label>
                        <input asp-for="AttachmentFiles" class="announcement-form-input announcement-form-input--file" type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.ppt,.pptx,.zip,.rar,.jpg,.jpeg,.png" />
                        <span class="announcement-form-help">@Model.AttachmentHelpText</span>
                        <span asp-validation-for="AttachmentFiles" class="announcement-form-validation"></span>
                    </div>

                    <div class="announcement-form-field announcement-form-field--full">
                        <label asp-for="GalleryFiles">@Model.GalleryLabel</label>
                        <input asp-for="GalleryFiles" class="announcement-form-input announcement-form-input--file" type="file" multiple accept=".jpg,.jpeg,.png,.webp,.gif" />
                        <span class="announcement-form-help">@Model.GalleryHelpText</span>
                        <span asp-validation-for="GalleryFiles" class="announcement-form-validation"></span>
                    </div>
                </div>

                <div class="announcement-form-actions">
                    <button type="submit" class="announcement-form-actions__save">@Model.SaveButtonText</button>
                    <a asp-action="@Model.IndexAction" class="announcement-form-actions__cancel">@Model.CancelButtonText</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#summernote').summernote({
                placeholder: '@Html.Raw(Model.EditorPlaceholder.Replace("'", "\\'"))',
                tabsize: 2,
                height: 320,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview']]
                ]
            });
        });
    </script>
}
