@model MEC.Portal.Models.AnnouncementListViewModel

@{
    ViewData["Title"] = "Duyurular";
    var isActiveFilter = string.Equals(Model.Status, "active", StringComparison.OrdinalIgnoreCase);
}

<section class="announcement-board-page">
    <div class="announcement-board-shell">
        <div class="announcement-board-header">
            <div class="announcement-board-header__copy">
                <span class="announcement-board-header__eyebrow">Duyuru yönetimi</span>
                <h1>Duyurular</h1>
                <p>Aktif ve pasif duyurulari tarih sirasiyla goruntuleyin, kartlardan secerek guncelleme ekranina gecin.</p>
            </div>

            <a asp-action="Create" class="announcement-board-header__action">Yeni Duyuru</a>
        </div>

        @if (TempData["AnnouncementSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="announcement-board-alert">@successMessage</div>
        }

        <div class="announcement-board-filters">
            <a asp-action="Index" asp-route-status="active" class="@(isActiveFilter ? "announcement-board-filter is-active" : "announcement-board-filter")">Aktif</a>
            <a asp-action="Index" asp-route-status="passive" class="@(!isActiveFilter ? "announcement-board-filter is-active" : "announcement-board-filter")">Pasif</a>
        </div>

        @if (Model.Items.Any())
        {
            <div class="announcement-board-grid">
                @foreach (var item in Model.Items)
                {
                    var dayText = item.CreatedDate?.ToString("dd") ?? "--";
                    var monthText = item.CreatedDate?.ToString("MMM", new System.Globalization.CultureInfo("tr-TR")).ToUpperInvariant() ?? "---";

                    <a asp-action="Edit" asp-route-id="@item.Id" class="announcement-board-card">
                        <article class="announcement-board-card__surface">
                            <div class="announcement-board-card__head">
                                <div class="announcement-board-card__brand">
                                    <span class="announcement-board-card__date-badge" aria-hidden="true">
                                        <strong>@dayText</strong>
                                        <small>@monthText</small>
                                    </span>
                                    <div class="announcement-board-card__title-wrap">
                                        <h2>@item.Title</h2>
                                        <span class="announcement-board-card__status @(item.IsActive ? "is-active" : "is-passive")">@(item.IsActive ? "Aktif" : "Pasif")</span>
                                        <span class="announcement-board-card__date">@(item.CreatedDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                                    </div>
                                </div>
                            </div>

                            <p class="announcement-board-card__summary">@item.Summary</p>
                        </article>
                    </a>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="announcement-board-pagination">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a asp-action="Index"
                           asp-route-status="@Model.Status"
                           asp-route-page="@pageNumber"
                           class="@(pageNumber == Model.CurrentPage ? "announcement-board-pagination__item is-active" : "announcement-board-pagination__item")">@pageNumber</a>
                    }
                </div>
            }
        }
        else
        {
            <div class="announcement-board-empty">
                <h2>Listelenecek duyuru bulunmuyor.</h2>
                <p>Seçili filtre için henüz bir duyuru kaydı yok. Yeni bir duyuru oluşturabilirsiniz.</p>
            </div>
        }
    </div>
</section>
