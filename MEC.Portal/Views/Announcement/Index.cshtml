@model IEnumerable<MEC.Domain.Entity.School.Announcement>

@{
    ViewData["Title"] = "Duyuru Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Portal'daki standart layout'u kullanıyoruz
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Duyuru Yönetimi (Admin Paneli)</h2>
        <a asp-action="Create" asp-controller="Announcement" class="btn btn-primary">Yeni Duyuru Ekle</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Başlık</th>
                        <th>Durum</th>
                        <th>Oluşturulma Tarihi</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pasif</span>
                                    }
                                </td>
                                <td>@(item.CreatedDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                <td class="text-center">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">Henüz eklenmiş bir duyuru bulunmuyor.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>