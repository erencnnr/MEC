@model MEC.Portal.Models.AnnouncementDetailViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = Model.IsAdminView
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";
}

<section class="announcement-detail-v2-page">
    <div class="announcement-detail-v2-shell">
        <div class="announcement-detail-v2-backbar">
            <a class="announcement-detail-v2-back"
               asp-controller="@Model.BackController"
               asp-action="@Model.BackAction">
                @Model.BackButtonText
            </a>
        </div>

        <div class="announcement-detail-v2-layout">
            <article class="announcement-detail-v2-main">
                <div class="announcement-detail-v2-hero">
                    <h1>@Model.Title</h1>

                    <div class="announcement-detail-v2-meta">
                        <span>Yayınlanma Tarihi: @(Model.CreatedDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                        <span>Güncellenme Tarihi: @(Model.UpdatedDate?.ToString("dd.MM.yyyy") ?? Model.CreatedDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                    </div>
                </div>

                <div class="announcement-detail-v2-section">
                    <h2>@Model.ContentBodyTitle</h2>
                    <div class="announcement-detail-v2-content">
                        @Html.Raw(Model.Content)
                    </div>
                </div>

                @if (Model.Attachments.Any())
                {
                    <div class="announcement-detail-v2-section">
                        <h2>@Model.AttachmentSectionTitle</h2>
                        <div class="announcement-detail-v2-links">
                            @foreach (var link in Model.Attachments)
                            {
                                <a class="announcement-detail-v2-link"
                                   href="@link.Url"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    <span class="announcement-detail-v2-link__dot"></span>
                                    <span>@link.Label</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (Model.GalleryImages.Any())
                {
                    <div class="announcement-detail-v2-section">
                        <h2>@Model.GallerySectionTitle</h2>
                        <div class="announcement-detail-v2-gallery">
                            @foreach (var imageUrl in Model.GalleryImages)
                            {
                                <a class="announcement-detail-v2-gallery__item" href="@imageUrl" target="_blank" rel="noopener noreferrer">
                                    <img src="@imageUrl" alt="@Model.Title" />
                                </a>
                            }
                        </div>
                    </div>
                }
            </article>

            <aside class="announcement-detail-v2-side">
                <div class="announcement-detail-v2-side__card">
                    <h3>@Model.RelatedSectionTitle</h3>

                    <div class="announcement-detail-v2-related">
                        @foreach (var relatedItem in Model.RelatedAnnouncements)
                        {
                            <a class="announcement-detail-v2-related__item"
                               asp-controller="@Model.DetailController"
                               asp-action="Detail"
                               asp-route-id="@relatedItem.Id">
                                <img src="@relatedItem.ImageUrl" alt="@relatedItem.Title" />
                                <div>
                                    <strong>@relatedItem.Title</strong>
                                    <span>@(relatedItem.CreatedDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                                </div>
                            </a>
                        }
                    </div>

                    <a class="announcement-detail-v2-side__action"
                       asp-controller="@Model.BackController"
                       asp-action="@Model.BackAction">
                        @Model.SideActionText
                    </a>
                </div>
            </aside>
        </div>
    </div>
</section>
