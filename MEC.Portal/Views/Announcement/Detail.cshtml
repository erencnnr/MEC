@model MEC.Domain.Entity.School.Announcement

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="announcement-detail-page">
    <div class="announcement-detail-page__head">
        <a class="announcement-detail-page__back" asp-controller="Home" asp-action="Announcements">Tüm duyurulara dön</a>
        <span class="announcement-detail-page__meta">Yayın tarihi: @(Model.CreatedDate?.ToString("dd MMMM yyyy, HH:mm") ?? "-")</span>
    </div>

    <article class="announcement-detail-card">
        <span class="announcement-detail-card__eyebrow">Kurumsal duyuru</span>
        <h1>@Model.Title</h1>
        <div class="announcement-detail-card__content">
            @Html.Raw(Model.Content)
        </div>
    </article>
</section>
