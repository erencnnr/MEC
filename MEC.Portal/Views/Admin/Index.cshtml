@model MEC.Portal.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Yönetim Paneli";
    Layout = "_AdminLayout";
}

<section class="dashboard-hero">
    <div>
        <span class="dashboard-hero__eyebrow">Yönetim merkezi</span>
        <p>
            İzin süreçlerini, duyuru trafiğini ve personel durumunu tek ekrandan takip edebilirsiniz.
        </p>
    </div>

    <a class="dashboard-hero__action"
       asp-controller="Admin"
       asp-action="LeaveRequests"
       asp-route-status="0">
        Bekleyen İzin Talepleri
    </a>
</section>

<section class="dashboard-metrics">
    <article class="dashboard-metric-card">
        <span class="dashboard-metric-card__label">Bekleyen izin talepleri</span>
        <strong>@Model.PendingLeaveCount</strong>
        <p>Onay bekleyen personel izin talepleri</p>
    </article>

    <article class="dashboard-metric-card">
        <span class="dashboard-metric-card__label">Toplam duyuru</span>
        <strong>@Model.TotalAnnouncementCount</strong>
        <p>Sistemde kayıtlı tüm duyurular</p>
    </article>

</section>

<section class="dashboard-grid">
    <article class="dashboard-panel">
        <div class="dashboard-panel__head">
            <div>
                <span class="dashboard-panel__eyebrow">Son izin talepleri</span>
                <h2>Yakın dönem istekleri</h2>
            </div>
            <a class="dashboard-panel__link" asp-controller="Admin" asp-action="LeaveRequests">Tüm talepler</a>
        </div>

        @if (Model.RecentLeaveRequests.Any())
        {
            <div class="dashboard-activity-list">
                @foreach (var item in Model.RecentLeaveRequests)
                {
                    <div class="dashboard-activity-item">
                        <div>
                            <h3>@item.EmployeeName</h3>
                            <p>@item.LeaveType, @item.RequestedDays.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) Gün</p>
                            <small>@item.StartDate.ToString("dd.MM.yyyy") / @item.EndDate.ToString("dd.MM.yyyy")</small>
                        </div>
                        <div class="dashboard-activity-item__side">
                            @if (item.Status == 0)
                            {
                                <span class="dashboard-badge dashboard-badge--pending">Bekliyor</span>
                            }
                            else if (item.Status == 1)
                            {
                                <span class="dashboard-badge dashboard-badge--success">Onaylandı</span>
                            }
                            else
                            {
                                <span class="dashboard-badge dashboard-badge--danger">Reddedildi</span>
                            }
                            <small>@(item.CreatedDate?.ToString("dd.MM.yyyy") ?? "-")</small>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="dashboard-empty-state">
                <h3>Henüz izin talebi yok</h3>
                <p>Yeni izin kayıtları oluştuğunda burada listelenecek.</p>
            </div>
        }
    </article>

    <article class="dashboard-panel">
        <div class="dashboard-panel__head">
            <div>
                <span class="dashboard-panel__eyebrow">Son duyurular</span>
                <h2>Yayın akışının özeti</h2>
            </div>
            <a class="dashboard-panel__link" asp-controller="Admin" asp-action="Announcements">Yönet</a>
        </div>

        @if (Model.RecentAnnouncements.Any())
        {
            <div class="dashboard-announcement-list">
                @foreach (var item in Model.RecentAnnouncements)
                {
                    <div class="dashboard-announcement-item">
                        <div>
                            <h3>@item.Title</h3>
                            <small>@(item.CreatedDate?.ToString("dd MMMM yyyy, HH:mm") ?? "-")</small>
                        </div>
                        <span class="dashboard-badge @(item.IsActive ? "dashboard-badge--info" : "dashboard-badge--muted")">
                            @(item.IsActive ? "Aktif" : "Pasif")
                        </span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="dashboard-empty-state">
                <h3>Henüz duyuru yok</h3>
                <p>Yeni duyurular oluşturulduğunda burada listelenecek.</p>
            </div>
        }
    </article>
</section>

