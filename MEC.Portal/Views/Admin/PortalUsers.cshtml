@model MEC.Portal.Models.AdminPortalUserListViewModel

@{
    ViewData["Title"] = "Portal Kullanıcıları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="leave-history-page admin-portal-users-page">
    <div class="leave-history-shell">
        <div class="leave-history-topbar">
            <div>
                <span class="leave-history-topbar__eyebrow">Yönetici işlemleri</span>
                <h1>Portal Kullanıcıları</h1>
                <p>Portal erişimi olan kullanıcıları inceleyin, aktiflik durumuna göre filtreleyin ve detaylarını yönetin.</p>
            </div>
        </div>

        <div id="bulkLeaveUploadAlert" class="admin-portal-users-upload-alert" hidden></div>

        <div class="admin-portal-users-controls">
            <div class="announcement-board-filters admin-portal-users-filters">
                <a asp-action="PortalUsers" asp-route-status="active" asp-route-search="@Model.SearchTerm" data-portal-users-status-filter="true" class="@(Model.Status == "active" ? "announcement-board-filter is-active" : "announcement-board-filter")">Aktif</a>
                <a asp-action="PortalUsers" asp-route-status="passive" asp-route-search="@Model.SearchTerm" data-portal-users-status-filter="true" class="@(Model.Status == "passive" ? "announcement-board-filter is-active" : "announcement-board-filter")">Pasif</a>
            </div>

            <div class="admin-portal-users-actions">
                <button type="button"
                        class="admin-portal-users-sync-button"
                        id="syncPortalUsersButton"
                        data-sync-url="/Admin/PortalUsers/Sync">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true" hidden></span>
                    <span class="admin-portal-users-action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M20 6v5h-5M4 18v-5h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                            <path d="M19 11a7 7 0 0 0-12-4.9L4 9M5 13a7 7 0 0 0 12 4.9l3-2.9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </span>
                    <span data-sync-submit-text>Kullanıcıları Senkronize Et</span>
                </button>

                <button type="button"
                        class="admin-portal-users-bulk-button"
                        data-bs-toggle="modal"
                        data-bs-target="#bulkLeaveUploadModal">
                    <span class="admin-portal-users-action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zm0 0v5h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                            <path d="M9 10.5l4 7M13 10.5l-4 7M8 14h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </span>
                    <span>Toplu İzin Yükle</span>
                </button>
            </div>
        </div>

        <form method="get" asp-action="PortalUsers" class="admin-portal-users-search" role="search">
            <input type="hidden" name="status" value="@Model.Status" />
            <label for="portalUserSearch">Kullanıcı ara</label>
            <div class="admin-portal-users-search__controls">
                <input id="portalUserSearch"
                       name="search"
                       value="@Model.SearchTerm"
                       type="search"
                       class="admin-portal-users-search__input"
                       placeholder="Ad soyad, e-posta veya telefon"
                       autocomplete="off" />
                <button type="submit" class="admin-portal-users-search__button">Ara</button>
                <button type="button"
                        class="admin-portal-users-search__clear @(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "is-hidden" : string.Empty)"
                        data-portal-users-search-clear="true">Temizle</button>
            </div>
        </form>

        <div id="portalUsersResults" class="admin-portal-users-results" aria-live="polite">
            <partial name="_PortalUserResults" model="Model" />
        </div>
    </div>

    <div class="modal fade bulk-leave-upload-modal" id="bulkLeaveUploadModal" tabindex="-1" aria-labelledby="bulkLeaveUploadModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bulk-leave-upload-modal__content">
                <form id="bulkLeaveUploadForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bulk-leave-upload-modal__header">
                        <div>
                            <span class="bulk-leave-upload-modal__eyebrow">Excel import</span>
                            <h2 class="modal-title" id="bulkLeaveUploadModalLabel">Toplu İzin Yükle</h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body bulk-leave-upload-modal__body">
                        <p class="bulk-leave-upload-modal__description">
                            Excel yüklemek için
                            <a class="bulk-leave-upload-modal__template-link" href="/Leave/BulkLeaveUpload/Template">şablon indir</a>.
                        </p>

                        <div id="bulkLeaveUploadModalAlert" class="admin-portal-users-upload-alert" hidden></div>

                        <label class="bulk-leave-upload-modal__file" for="bulkLeaveUploadFile">
                            <span>Excel dosyası</span>
                            <input id="bulkLeaveUploadFile" name="file" type="file" accept=".xlsx" required />
                            <small>Sadece .xlsx dosyaları desteklenir. Maksimum dosya boyutu 10 MB.</small>
                        </label>
                    </div>
                    <div class="modal-footer bulk-leave-upload-modal__footer">
                        <button type="button" class="bulk-leave-upload-modal__button bulk-leave-upload-modal__button--ghost" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="bulk-leave-upload-modal__button bulk-leave-upload-modal__button--primary" id="bulkLeaveUploadSubmit">
                            <span class="spinner-border spinner-border-sm" aria-hidden="true" hidden></span>
                            <span data-bulk-submit-text>Yükle</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function initializePortalUserRows(root) {
            (root || document).querySelectorAll(".leave-history-table__row").forEach(function (row) {
                row.addEventListener("click", function () {
                    var href = row.getAttribute("data-href");
                    if (href) {
                        window.location.href = href;
                    }
                });

                row.addEventListener("keydown", function (event) {
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        var href = row.getAttribute("data-href");
                        if (href) {
                            window.location.href = href;
                        }
                    }
                });
            });
        }

        initializePortalUserRows(document);

        (function () {
            var form = document.querySelector(".admin-portal-users-search");
            var input = document.getElementById("portalUserSearch");
            var results = document.getElementById("portalUsersResults");
            var clearButton = document.querySelector("[data-portal-users-search-clear='true']");
            var statusLinks = Array.from(document.querySelectorAll("[data-portal-users-status-filter='true']"));
            var debounceTimer = null;
            var activeRequest = null;

            if (!form || !input || !results) {
                return;
            }

            function updateSearchControls() {
                var searchTerm = input.value.trim();

                if (clearButton) {
                    clearButton.classList.toggle("is-hidden", !searchTerm);
                }

                statusLinks.forEach(function (link) {
                    var linkUrl = new URL(link.href, window.location.origin);
                    if (searchTerm) {
                        linkUrl.searchParams.set("search", searchTerm);
                    } else {
                        linkUrl.searchParams.delete("search");
                    }
                    linkUrl.searchParams.delete("page");
                    link.href = linkUrl.pathname + linkUrl.search;
                });
            }

            function buildSearchUrl() {
                var url = new URL(form.action, window.location.origin);
                var formData = new FormData(form);
                var searchTerm = input.value.trim();

                formData.set("search", searchTerm);
                formData.set("page", "1");
                url.search = new URLSearchParams(formData).toString();
                return url;
            }

            async function refreshResults(fallbackToNavigation) {
                var requestUrl = buildSearchUrl();

                if (activeRequest) {
                    activeRequest.abort();
                }

                var requestController = new AbortController();
                activeRequest = requestController;
                results.setAttribute("aria-busy", "true");
                results.classList.add("is-loading");

                try {
                    var response = await fetch(requestUrl, {
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        signal: requestController.signal
                    });

                    if (!response.ok) {
                        throw new Error("Arama sonuçları alınamadı.");
                    }

                    var html = await response.text();
                    if (activeRequest !== requestController) {
                        return;
                    }

                    results.innerHTML = html;
                    initializePortalUserRows(results);
                    window.history.replaceState(null, "", requestUrl.pathname + requestUrl.search);
                } catch (error) {
                    if (error.name !== "AbortError" && fallbackToNavigation) {
                        window.location.href = requestUrl.pathname + requestUrl.search;
                    }
                } finally {
                    if (activeRequest === requestController) {
                        activeRequest = null;
                        results.removeAttribute("aria-busy");
                        results.classList.remove("is-loading");
                    }
                }
            }

            input.addEventListener("input", function () {
                window.clearTimeout(debounceTimer);
                updateSearchControls();
                debounceTimer = window.setTimeout(function () {
                    refreshResults(false);
                }, 200);
            });

            form.addEventListener("submit", function (event) {
                event.preventDefault();
                window.clearTimeout(debounceTimer);
                updateSearchControls();
                refreshResults(true);
            });

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    input.value = "";
                    updateSearchControls();
                    refreshResults(false);
                    input.focus();
                });
            }

            updateSearchControls();
        })();

        function renderPortalUsersAlert(target, level, message, reportUrl) {
            if (!target) {
                return;
            }

            target.hidden = false;
            target.className = "admin-portal-users-upload-alert admin-portal-users-upload-alert--" + (level || "danger");
            target.replaceChildren();

            var messageElement = document.createElement("span");
            messageElement.textContent = message || "İşlem sonucu alınamadı.";
            target.appendChild(messageElement);

            if (reportUrl) {
                var link = document.createElement("a");
                link.href = reportUrl;
                link.textContent = "Hatalı satır raporunu indir";
                link.className = "admin-portal-users-upload-alert__link";
                target.appendChild(link);
            }
        }

        function clearPortalUsersAlert(target) {
            if (!target) {
                return;
            }

            target.hidden = true;
            target.replaceChildren();
        }

        (function () {
            var syncButton = document.getElementById("syncPortalUsersButton");
            if (!syncButton) {
                return;
            }

            var pageAlert = document.getElementById("bulkLeaveUploadAlert");
            var syncText = syncButton.querySelector("[data-sync-submit-text]");
            var syncSpinner = syncButton.querySelector(".spinner-border");
            var tokenInput = document.querySelector("input[name='__RequestVerificationToken']");

            function setSyncLoading(isLoading) {
                syncButton.disabled = isLoading;

                if (syncText) {
                    syncText.textContent = isLoading ? "Senkronize ediliyor..." : "Kullanıcıları Senkronize Et";
                }

                if (syncSpinner) {
                    syncSpinner.hidden = !isLoading;
                }
            }

            syncButton.addEventListener("click", async function () {
                clearPortalUsersAlert(pageAlert);
                setSyncLoading(true);

                try {
                    var response = await fetch(syncButton.dataset.syncUrl || "/Admin/PortalUsers/Sync", {
                        method: "POST",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest",
                            "RequestVerificationToken": tokenInput ? tokenInput.value : ""
                        }
                    });

                    var result = await response.json();
                    renderPortalUsersAlert(
                        pageAlert,
                        result.level || (response.ok ? "success" : "danger"),
                        response.ok ? "Kullanıcılar başarıyla senkronize edildi." : "Hata! Senkronizasyon başarısız.",
                        null);
                } catch (error) {
                    renderPortalUsersAlert(pageAlert, "danger", "Hata! Senkronizasyon başarısız.", null);
                } finally {
                    setSyncLoading(false);
                }
            });
        })();

        (function () {
            var form = document.getElementById("bulkLeaveUploadForm");
            if (!form) {
                return;
            }

            var modalElement = document.getElementById("bulkLeaveUploadModal");
            var pageAlert = document.getElementById("bulkLeaveUploadAlert");
            var modalAlert = document.getElementById("bulkLeaveUploadModalAlert");
            var submitButton = document.getElementById("bulkLeaveUploadSubmit");
            var submitText = submitButton ? submitButton.querySelector("[data-bulk-submit-text]") : null;
            var spinner = submitButton ? submitButton.querySelector(".spinner-border") : null;
            var formatter = new Intl.NumberFormat("tr-TR", { maximumFractionDigits: 2 });

            function setLoading(isLoading) {
                if (!submitButton) {
                    return;
                }

                submitButton.disabled = isLoading;
                if (submitText) {
                    submitText.textContent = isLoading ? "Yükleniyor..." : "Yükle";
                }
                if (spinner) {
                    spinner.hidden = !isLoading;
                }
            }

            function updateVisibleLeaveDays(updatedUsers) {
                if (!Array.isArray(updatedUsers)) {
                    return;
                }

                var cells = document.querySelectorAll(".admin-portal-users-table__leave-days[data-user-email]");
                updatedUsers.forEach(function (user) {
                    var email = (user.email || "").toLowerCase();
                    if (!email) {
                        return;
                    }

                    cells.forEach(function (cell) {
                        if ((cell.dataset.userEmail || "").toLowerCase() === email) {
                            cell.textContent = formatter.format(Number(user.newLeaveDays || 0)) + " Gün";
                        }
                    });
                });
            }

            form.addEventListener("submit", async function (event) {
                event.preventDefault();
                clearPortalUsersAlert(pageAlert);
                clearPortalUsersAlert(modalAlert);

                var formData = new FormData(form);
                setLoading(true);

                try {
                    var response = await fetch("/Leave/BulkLeaveUpload", {
                        method: "POST",
                        body: formData,
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    });

                    var result = await response.json();
                    if (result.success) {
                        var modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                        modal.hide();
                        form.reset();
                        renderPortalUsersAlert(pageAlert, result.level, result.message, result.errorReportUrl);
                        updateVisibleLeaveDays(result.updatedUsers);
                    } else {
                        renderPortalUsersAlert(modalAlert, result.level, result.message, result.errorReportUrl);
                        renderPortalUsersAlert(pageAlert, result.level, result.message, result.errorReportUrl);
                    }
                } catch (error) {
                    renderPortalUsersAlert(modalAlert, "danger", "Toplu izin yükleme sırasında beklenmeyen bir hata oluştu.", null);
                } finally {
                    setLoading(false);
                }
            });
        })();
    </script>
}
