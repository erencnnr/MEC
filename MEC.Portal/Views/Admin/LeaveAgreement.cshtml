@using System.Globalization
@model MEC.Portal.Models.AdminLeaveAgreementListViewModel

@{
    ViewData["Title"] = "Izin Mutabakat";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var resultMessage = TempData["LeaveAgreementMessage"] as string;
    var resultLevelValue = TempData["LeaveAgreementLevel"] as string;
    var resultLevel = string.Equals(resultLevelValue, "success", StringComparison.OrdinalIgnoreCase)
        ? "success"
        : string.Equals(resultLevelValue, "warning", StringComparison.OrdinalIgnoreCase)
            ? "warning"
            : "error";
}

<section class="inventory-page">
    <div class="inventory-page__header">
        <div>
            <span class="inventory-page__eyebrow">YONETICI ISLEMLERI</span>
            <h1 class="inventory-page__title">Izin Mutabakat</h1>
            <p class="inventory-page__subtitle">Mutabakat kayitlarini arayin, imza durumunu filtreleyin ve satir bazli guncelleyin.</p>
        </div>
        <div class="inventory-page__actions">
            <button type="button"
                    class="inventory-button inventory-button--success"
                    data-bs-toggle="modal"
                    data-bs-target="#leaveAgreementUploadModal">
                Excel Yukle
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(resultMessage))
    {
        <div class="inventory-inline-alert inventory-inline-alert--@resultLevel" id="leaveAgreementResultAlert">@resultMessage</div>
    }

    <div class="inventory-table-card">
        <form method="get" asp-controller="Admin" asp-action="LeaveAgreement" id="leaveAgreementFilterForm">
            <input type="hidden" name="page" id="leaveAgreementPageInput" value="@Model.CurrentPage" />
            <input type="hidden" name="sortOrder" id="leaveAgreementSortOrderInput" value="@Model.SortOrder" />
            <input type="hidden" name="isSigned" id="leaveAgreementIsSignedInput" value="@(Model.SelectedIsSigned.HasValue ? Model.SelectedIsSigned.Value.ToString().ToLowerInvariant() : string.Empty)" />

            <div class="inventory-table-card__meta">
                <span>@Model.TotalCount kayit</span>
                <div class="inventory-table-card__meta-actions">
                    <div class="inventory-search inventory-search--compact">
                        <input type="text" name="searchText" value="@Model.SearchText" class="inventory-search__input" placeholder="Ad, soyad, telefon veya e-posta..." />
                        <button type="submit" class="inventory-search__button inventory-search__button--icon" onclick="resetLeaveAgreementPage()" aria-label="Ara">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M10.5 4.5C7.18629 4.5 4.5 7.18629 4.5 10.5C4.5 13.8137 7.18629 16.5 10.5 16.5C13.8137 16.5 16.5 13.8137 16.5 10.5C16.5 7.18629 13.8137 4.5 10.5 4.5Z" stroke="currentColor" stroke-width="2" />
                                <path d="M15.25 15.25L19.5 19.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </button>
                    </div>
                    <span>Sayfa @Model.CurrentPage / @Math.Max(Model.TotalPages, 1)</span>
                    @if (Model.HasActiveFilters)
                    {
                        <a asp-controller="Admin" asp-action="LeaveAgreement" class="inventory-button inventory-button--ghost inventory-button--small">Temizle</a>
                    }
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table inventory-table leave-agreement-table mb-0">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th class="leave-agreement-table__days-col">Mutabik Kalinan Izin Gun</th>
                        <th class="leave-agreement-table__signed-col">
                            <div class="inventory-table__header-filter">
                                <span>Mutabakat Imzalandi</span>
                                <div class="dropdown" data-bs-auto-close="outside">
                                    <button class="inventory-table__filter-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="inventory-table__filter-icon @(Model.SelectedIsSigned.HasValue ? "is-active" : string.Empty)" aria-hidden="true">
                                            <svg viewBox="0 0 16 16" fill="none">
                                                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                    </button>
                                    <div class="dropdown-menu inventory-table__filter-menu inventory-table__filter-menu--compact">
                                        <button type="button" class="inventory-dropdown-action @(!Model.SelectedIsSigned.HasValue ? "is-active" : string.Empty)" onclick="changeLeaveAgreementSignedFilter('')">Tumu</button>
                                        <button type="button" class="inventory-dropdown-action @(Model.SelectedIsSigned == true ? "is-active" : string.Empty)" onclick="changeLeaveAgreementSignedFilter('true')">Evet</button>
                                        <button type="button" class="inventory-dropdown-action @(Model.SelectedIsSigned == false ? "is-active" : string.Empty)" onclick="changeLeaveAgreementSignedFilter('false')">Hayir</button>
                                    </div>
                                </div>
                            </div>
                        </th>
                        <th>
                            <div class="inventory-table__header-filter">
                                <span>Olusturma Tarihi</span>
                                <div class="dropdown" data-bs-auto-close="outside">
                                    <button class="inventory-table__filter-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="inventory-table__filter-icon @(!string.IsNullOrWhiteSpace(Model.SortOrder) ? "is-active" : string.Empty)" aria-hidden="true">
                                            <svg viewBox="0 0 16 16" fill="none">
                                                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                    </button>
                                    <div class="dropdown-menu inventory-table__filter-menu inventory-table__filter-menu--compact">
                                        <button type="button" class="inventory-dropdown-action @(Model.SortOrder == "CreatedDate_Desc" ? "is-active" : string.Empty)" onclick="changeLeaveAgreementSort('CreatedDate_Desc')">Yeniden Eskiye</button>
                                        <button type="button" class="inventory-dropdown-action @(Model.SortOrder == "CreatedDate_Asc" ? "is-active" : string.Empty)" onclick="changeLeaveAgreementSort('CreatedDate_Asc')">Eskiden Yeniye</button>
                                    </div>
                                </div>
                            </div>
                        </th>
                        <th class="text-end">Islemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            var formId = $"leaveAgreementForm-{item.Id}";
                            <tr>
                                <td>@item.FirstName</td>
                                <td>@item.LastName</td>
                                <td>@item.Email</td>
                                <td>@item.PhoneNumber</td>
                                <td class="leave-agreement-table__days-col">
                                    <input type="number"
                                           step="0.01"
                                           min="0"
                                           name="agreedLeaveDays"
                                           value="@item.AgreedLeaveDaysInput"
                                           class="inventory-input"
                                           form="@formId" />
                                </td>
                                <td class="leave-agreement-table__signed-col">
                                    <select name="isSigned" class="inventory-select" form="@formId">
                                        @if (item.IsSigned)
                                        {
                                            <option value="false">Hayir</option>
                                            <option value="true" selected>Evet</option>
                                        }
                                        else
                                        {
                                            <option value="false" selected>Hayir</option>
                                            <option value="true">Evet</option>
                                        }
                                    </select>
                                </td>
                                <td>@(item.CreatedDate?.ToString("dd.MM.yyyy HH:mm", CultureInfo.GetCultureInfo("tr-TR")) ?? "-")</td>
                                <td class="text-end">
                                    @{
                                        var uploadFormId = $"leaveAgreementPdfUploadForm-{item.Id}";
                                        var uploadInputId = $"leaveAgreementPdfUploadFile-{item.Id}";
                                        var actionsModalId = $"leaveAgreementActionsModal-{item.Id}";
                                    }
                                    <form id="@formId" method="post" asp-controller="Admin" asp-action="UpdateLeaveAgreement" asp-route-id="@item.Id">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    </form>
                                    <form id="@uploadFormId" method="post" enctype="multipart/form-data" asp-controller="Admin" asp-action="UploadLeaveAgreementPdf" asp-route-id="@item.Id">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                        <input id="@uploadInputId"
                                               class="leave-agreement-table__file-input"
                                               name="file"
                                               type="file"
                                               accept="application/pdf,.pdf"
                                               onchange="submitLeaveAgreementPdfUpload('@uploadFormId')" />
                                    </form>
                                    <button class="inventory-button inventory-button--ghost inventory-button--small"
                                            type="button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#@actionsModalId">
                                        Islemler
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="inventory-table__empty">Kayit bulunamadi.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="inventory-pagination" aria-label="Izin mutabakat sayfalama">
            <button type="button" class="inventory-pagination__button" onclick="changeLeaveAgreementPage(@(Model.CurrentPage - 1))" disabled="@(Model.CurrentPage == 1 ? "disabled" : null)">Onceki</button>
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <button type="button" class="inventory-pagination__button @(pageNumber == Model.CurrentPage ? "is-active" : string.Empty)" onclick="changeLeaveAgreementPage(@pageNumber)">@pageNumber</button>
            }
            <button type="button" class="inventory-pagination__button" onclick="changeLeaveAgreementPage(@(Model.CurrentPage + 1))" disabled="@(Model.CurrentPage == Model.TotalPages ? "disabled" : null)">Sonraki</button>
        </div>
    }
</section>

@foreach (var item in Model.Items)
{
    var formId = $"leaveAgreementForm-{item.Id}";
    var uploadInputId = $"leaveAgreementPdfUploadFile-{item.Id}";
    var actionsModalId = $"leaveAgreementActionsModal-{item.Id}";
    var actionsModalLabelId = $"leaveAgreementActionsModalLabel-{item.Id}";

    <div class="modal fade leave-agreement-actions-modal" id="@actionsModalId" tabindex="-1" aria-labelledby="@actionsModalLabelId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content leave-agreement-actions-modal__content">
                <div class="modal-header leave-agreement-actions-modal__header">
                    <div>
                        <span class="leave-agreement-actions-modal__eyebrow">Mutabakat islemleri</span>
                        <h2 class="modal-title" id="@actionsModalLabelId">@item.FirstName @item.LastName</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body leave-agreement-actions-modal__body">
                    <button type="submit" class="leave-agreement-actions-modal__button leave-agreement-actions-modal__button--primary" form="@formId">
                        Kaydet
                    </button>
                    <a class="leave-agreement-actions-modal__button leave-agreement-actions-modal__button--ghost"
                       asp-controller="Admin"
                       asp-action="PrintLeaveAgreement"
                       asp-route-id="@item.Id"
                       target="_blank"
                       rel="noopener">
                        Mutabakat yazdir
                    </a>
                    <button type="button" class="leave-agreement-actions-modal__button leave-agreement-actions-modal__button--ghost" onclick="triggerLeaveAgreementPdfUpload('@uploadInputId')">
                        Mutabakat yukle
                    </button>
                    @if (item.HasAgreementPdf)
                    {
                        <a class="leave-agreement-actions-modal__button leave-agreement-actions-modal__button--ghost"
                           asp-controller="Admin"
                           asp-action="ViewLeaveAgreementPdf"
                           asp-route-id="@item.Id"
                           target="_blank"
                           rel="noopener"
                           title="@item.AgreementPdfOriginalFileName">
                            Mutabakat goruntule
                        </a>
                    }
                    else
                    {
                        <button type="button" class="leave-agreement-actions-modal__button leave-agreement-actions-modal__button--disabled" disabled>
                            Mutabakat goruntule
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade bulk-leave-upload-modal" id="leaveAgreementUploadModal" tabindex="-1" aria-labelledby="leaveAgreementUploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bulk-leave-upload-modal__content">
            <form method="post" enctype="multipart/form-data" asp-controller="Admin" asp-action="UploadLeaveAgreement">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@currentUrl" />
                <div class="modal-header bulk-leave-upload-modal__header">
                    <div>
                        <span class="bulk-leave-upload-modal__eyebrow">Excel import</span>
                        <h2 class="modal-title" id="leaveAgreementUploadModalLabel">Izin Mutabakat Excel Yukle</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body bulk-leave-upload-modal__body">
                    <p class="bulk-leave-upload-modal__description">
                        Excel sirasi: <strong>Ad</strong>, <strong>Soyad</strong>, <strong>Eposta</strong>, <strong>Telefon</strong>, <strong>Mutabik kalinan izin gun</strong>.
                    </p>
                    <label class="bulk-leave-upload-modal__file" for="leaveAgreementUploadFile">
                        <span>Excel dosyasi</span>
                        <input id="leaveAgreementUploadFile" name="file" type="file" accept=".xlsx" required />
                        <small>Sadece .xlsx dosyalari desteklenir. Maksimum dosya boyutu 10 MB.</small>
                    </label>
                </div>
                <div class="modal-footer bulk-leave-upload-modal__footer">
                    <button type="button" class="bulk-leave-upload-modal__button bulk-leave-upload-modal__button--ghost" data-bs-dismiss="modal">Vazgec</button>
                    <button type="submit" class="bulk-leave-upload-modal__button bulk-leave-upload-modal__button--primary">Yukle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function resetLeaveAgreementPage() {
            document.getElementById('leaveAgreementPageInput').value = 1;
        }

        function changeLeaveAgreementPage(page) {
            if (page < 1) {
                return;
            }

            document.getElementById('leaveAgreementPageInput').value = page;
            document.getElementById('leaveAgreementFilterForm').submit();
        }

        function changeLeaveAgreementSignedFilter(value) {
            document.getElementById('leaveAgreementIsSignedInput').value = value;
            resetLeaveAgreementPage();
            document.getElementById('leaveAgreementFilterForm').submit();
        }

        function changeLeaveAgreementSort(sortOrder) {
            document.getElementById('leaveAgreementSortOrderInput').value = sortOrder;
            resetLeaveAgreementPage();
            document.getElementById('leaveAgreementFilterForm').submit();
        }

        function triggerLeaveAgreementPdfUpload(inputId) {
            const input = document.getElementById(inputId);
            if (input) {
                input.click();
            }
        }

        function submitLeaveAgreementPdfUpload(formId) {
            const form = document.getElementById(formId);
            if (form) {
                form.submit();
            }
        }

        window.setTimeout(function () {
            const alert = document.getElementById('leaveAgreementResultAlert');
            if (alert) {
                alert.style.transition = 'opacity 0.3s ease';
                alert.style.opacity = '0';
                window.setTimeout(function () { alert.remove(); }, 300);
            }
        }, 4000);
    </script>
}
