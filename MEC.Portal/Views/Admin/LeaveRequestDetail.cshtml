@using System.Globalization
@model MEC.Portal.Models.AdminLeaveRequestDetailViewModel

@{
    ViewData["Title"] = "İzin Talep Detayları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var item = Model.Item;
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var statusMessage = TempData["AdminLeaveStatusMessage"] as string;
    var statusLevel = string.Equals(TempData["AdminLeaveStatusLevel"] as string, "success", StringComparison.OrdinalIgnoreCase)
        ? "success"
        : "error";

    string FormatLeaveDays(decimal value)
    {
        return value.ToString("0.##", CultureInfo.GetCultureInfo("tr-TR"));
    }
}

<section class="leave-detail-page admin-leave-detail-page">
    <div class="leave-detail-shell">
        <div class="leave-detail-header">
            <a class="leave-detail-back" asp-controller="Admin" asp-action="LeaveRequests">İzin taleplerine geri dön</a>

            <div class="leave-detail-title">
                <span class="leave-detail-title__eyebrow">Yönetici işlemleri</span>
                <h1>İzin Talep Detayları</h1>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="admin-leave-toast admin-leave-toast--@statusLevel" data-admin-leave-toast>
                <span>@statusMessage</span>
                <button type="button" data-admin-leave-toast-close aria-label="Bildirimi kapat">×</button>
            </div>
        }

        <div class="leave-detail-card">
            <div class="leave-detail-grid">
                <div class="leave-detail-field">
                    <span>Çalışan</span>
                    <strong>@item.EmployeeName</strong>
                </div>

                <div class="leave-detail-field">
                    <span>Durum</span>
                    <strong>@item.StatusLabel</strong>
                </div>

                <div class="leave-detail-field">
                    <span>Lokasyon</span>
                    <strong>@item.LocationNames</strong>
                </div>

                <div class="leave-detail-field">
                    <span>Okul Müdürü Kararı</span>
                    <strong>@item.ManagerDecisionDisplay</strong>
                </div>

                <div class="leave-detail-field">
                    <span>Onaylayan / Reddeden</span>
                    <strong>@item.DecisionDisplay</strong>
                </div>

                <div class="leave-detail-field">
                    <span>İzin Türü</span>
                    <strong>@item.LeaveType</strong>
                </div>

                <div class="leave-detail-field">
                    <span>Oluşturma Tarihi</span>
                    <strong>@(item.CreatedDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</strong>
                </div>

                <div class="leave-detail-field">
                    <span>Başlangıç Tarihi</span>
                    <strong>@item.StartDate.ToString("dd.MM.yyyy HH:mm")</strong>
                </div>

                <div class="leave-detail-field">
                    <span>Bitiş Tarihi</span>
                    <strong>@item.EndDate.ToString("dd.MM.yyyy HH:mm")</strong>
                </div>

                <div class="leave-detail-field">
                    <span>Kullanılan Gün Sayısı</span>
                    <strong>@FormatLeaveDays(item.RequestedDays) Gün</strong>
                </div>

            </div>

            <div class="leave-detail-reason">
                <span>Açıklama</span>
                <div class="leave-detail-reason__box">
                    @(string.IsNullOrWhiteSpace(item.Reason) ? "-" : item.Reason)
                </div>
            </div>

            <div class="admin-leave-detail-actions">
                @if (item.CanTakeAction)
                {
                    <form asp-controller="Admin" asp-action="UpdateLeaveStatus" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="status" value="1" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="button"
                                class="admin-leave-action admin-leave-action--approve"
                                data-admin-leave-confirm
                                data-confirm-tone="approve"
                                data-confirm-title="İzin talebini onayla"
                                data-confirm-message="Bu izin talebini onaylamak istediğinize emin misiniz?"
                                data-confirm-label="Onayla">
                            Onayla
                        </button>
                    </form>

                    <form asp-controller="Admin" asp-action="UpdateLeaveStatus" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="status" value="2" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="button"
                                class="admin-leave-action admin-leave-action--reject"
                                data-admin-leave-confirm
                                data-confirm-tone="reject"
                                data-confirm-title="İzin talebini reddet"
                                data-confirm-message="Bu izin talebini reddetmek istediğinize emin misiniz?"
                                data-confirm-label="Reddet">
                            Reddet
                        </button>
                    </form>
                }
                else
                {
                    <div class="admin-leave-note">@(item.Status == 0 || item.Status == 4 ? "Bu talepte onay sırası başka bir yetkilide." : "Bu talep için işlem tamamlandı.")</div>
                }
            </div>
        </div>
    </div>
</section>

<div class="admin-leave-confirm-modal" id="adminLeaveConfirmModal" hidden aria-hidden="true">
    <div class="admin-leave-confirm-modal__backdrop" data-admin-leave-confirm-close></div>
    <div class="admin-leave-confirm-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="adminLeaveConfirmTitle">
        <button type="button" class="admin-leave-confirm-modal__close" data-admin-leave-confirm-close aria-label="Kapat">×</button>
        <span class="admin-leave-confirm-modal__eyebrow">İzin işlemi</span>
        <h2 id="adminLeaveConfirmTitle">İzin talebini güncelle</h2>
        <p id="adminLeaveConfirmMessage">Bu işlemi gerçekleştirmek istediğinize emin misiniz?</p>
        <div class="admin-leave-confirm-modal__actions">
            <button type="button" class="admin-leave-confirm-modal__button admin-leave-confirm-modal__button--ghost" data-admin-leave-confirm-close>Vazgeç</button>
            <button type="button" class="admin-leave-confirm-modal__button admin-leave-confirm-modal__button--approve" id="adminLeaveConfirmSubmit">Onayla</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const adminLeaveToast = document.querySelector("[data-admin-leave-toast]");
        if (adminLeaveToast) {
            const closeToast = function () {
                adminLeaveToast.classList.add("is-hiding");
                window.setTimeout(function () {
                    adminLeaveToast.remove();
                }, 260);
            };

            const toastCloseButton = adminLeaveToast.querySelector("[data-admin-leave-toast-close]");
            if (toastCloseButton) {
                toastCloseButton.addEventListener("click", closeToast);
            }

            window.setTimeout(closeToast, 4500);
        }

        const confirmModal = document.getElementById("adminLeaveConfirmModal");
        const confirmTitle = document.getElementById("adminLeaveConfirmTitle");
        const confirmMessage = document.getElementById("adminLeaveConfirmMessage");
        const confirmSubmit = document.getElementById("adminLeaveConfirmSubmit");
        let activeLeaveStatusForm = null;

        function closeAdminLeaveConfirmModal() {
            if (!confirmModal) {
                return;
            }

            confirmModal.hidden = true;
            confirmModal.setAttribute("aria-hidden", "true");
            document.body.classList.remove("admin-leave-confirm-open");
            activeLeaveStatusForm = null;
        }

        document.querySelectorAll("[data-admin-leave-confirm]").forEach(function (button) {
            button.addEventListener("click", function (event) {
                event.preventDefault();

                activeLeaveStatusForm = button.closest("form");
                if (!confirmModal || !activeLeaveStatusForm) {
                    return;
                }

                const tone = button.dataset.confirmTone === "reject" ? "reject" : "approve";
                confirmTitle.textContent = button.dataset.confirmTitle || "İzin talebini güncelle";
                confirmMessage.textContent = button.dataset.confirmMessage || "Bu işlemi gerçekleştirmek istediğinize emin misiniz?";
                confirmSubmit.textContent = button.dataset.confirmLabel || "Onayla";
                confirmSubmit.className = "admin-leave-confirm-modal__button admin-leave-confirm-modal__button--" + tone;

                confirmModal.hidden = false;
                confirmModal.setAttribute("aria-hidden", "false");
                document.body.classList.add("admin-leave-confirm-open");
                confirmSubmit.focus();
            });
        });

        document.querySelectorAll("[data-admin-leave-confirm-close]").forEach(function (element) {
            element.addEventListener("click", closeAdminLeaveConfirmModal);
        });

        if (confirmSubmit) {
            confirmSubmit.addEventListener("click", function () {
                if (activeLeaveStatusForm) {
                    activeLeaveStatusForm.submit();
                }
            });
        }

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && confirmModal && !confirmModal.hidden) {
                closeAdminLeaveConfirmModal();
            }
        });
    </script>
}
