@using MEC.Domain.Common.Enum
@using System.Globalization
@model MEC.Portal.Models.AdminPortalUserEditViewModel

@{
    ViewData["Title"] = "Portal Kullanıcısı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string FormatLeaveDays(decimal value)
    {
        return value.ToString("0.##", CultureInfo.GetCultureInfo("tr-TR"));
    }

    var currentYear = DateTime.Today.Year;
}

<section class="leave-detail-page admin-portal-user-detail-page">
    <div class="leave-detail-shell">
        <div class="leave-detail-header">
            <a class="leave-detail-back" asp-controller="Admin" asp-action="PortalUsers">Portal kullanıcılarına geri dön</a>

            <div class="leave-detail-title">
                <span class="leave-detail-title__eyebrow">Yönetici işlemleri</span>
                <h1>Portal Kullanıcısı</h1>
            </div>
        </div>

        @if (TempData["PortalUserSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="announcement-form-alert announcement-form-alert--success">@successMessage</div>
        }

        <div class="leave-detail-card admin-portal-user-card">
            <form method="post"
                  class="admin-portal-user-form"
                  data-child-editor="true"
                  data-manager-location-form="true">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="announcement-form-alert announcement-form-alert--error"></div>

                <div class="admin-portal-user-loan-actions">
                    @if (Model.HasLoanRecords)
                    {
                        <a class="leave-history-topbar__action"
                           asp-controller="Loans"
                           asp-action="Index"
                           asp-route-ActiveTab="@Model.PreferredLoanTab"
                           asp-route-AssignedToIds="@Model.Id">Zimmetleri Görüntüle</a>
                    }
                    else
                    {
                        <button type="button"
                                class="leave-history-topbar__action"
                                data-bs-toggle="modal"
                                data-bs-target="#noLoanRecordsModal">Zimmetleri Görüntüle</button>
                    }
                </div>

                @if (Model.HasActiveLoans)
                {
                    <div class="admin-portal-user-loan-warning" id="activeLoanWarning" data-active-loan-warning="true">
                        <strong>Aktif zimmet uyarısı</strong>
                        <p>
                            Bu kullanıcıya ait @Model.ActiveLoans.Count aktif zimmet bulunuyor. Kullanıcıyı pasife almadan önce zimmetleri kontrol edin.
                        </p>
                        <ul>
                            @foreach (var loan in Model.ActiveLoans)
                            {
                                <li>
                                    <a asp-controller="Assets" asp-action="AssetInfo" asp-route-id="@loan.AssetId">@loan.AssetName</a>
                                    @if (!string.IsNullOrWhiteSpace(loan.SerialNumber))
                                    {
                                        <span>Seri no: @loan.SerialNumber</span>
                                    }
                                </li>
                            }
                        </ul>
                        <label class="admin-portal-user-loan-warning__confirmation">
                            <input asp-for="ActiveLoanWarningAccepted" />
                            <span>Aktif zimmetleri gördüm, kullanıcıyı pasife alma işlemine devam et.</span>
                        </label>
                    </div>
                }

                <div class="leave-detail-grid admin-portal-user-grid">
                    <div class="leave-detail-field">
                        <span>Ad</span>
                        <input asp-for="FirstName" class="announcement-form-input" />
                        <span asp-validation-for="FirstName" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field">
                        <span>Soyad</span>
                        <input asp-for="LastName" class="announcement-form-input" />
                        <span asp-validation-for="LastName" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field">
                        <span>E-posta</span>
                        <input asp-for="Email" type="email" inputmode="email" autocomplete="email" class="announcement-form-input" placeholder="ornek@firma.com" />
                        <span asp-validation-for="Email" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field">
                        <span>Telefon</span>
                        <input asp-for="PhoneNumber"
                               type="tel"
                               inputmode="numeric"
                               autocomplete="tel-national"
                               placeholder="0xxx xxx xx xx"
                               data-phone-input="true"
                               class="announcement-form-input" />
                        <span asp-validation-for="PhoneNumber" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field">
                        <span>Ünvan</span>
                        <input asp-for="Title" class="announcement-form-input" />
                        <span asp-validation-for="Title" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field">
                        <span>İşe Giriş Tarihi</span>
                        <input asp-for="HireDate" type="date" min="1900-01-01" class="announcement-form-input" />
                        <select class="announcement-form-input" data-date-year-select="true" data-date-year-target="HireDate" aria-label="İşe giriş yılına hızlı git">
                            <option value="">Hızlı yıl seçin</option>
                            @for (var year = currentYear; year >= 1900; year--)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                        <small class="admin-portal-user-field-note">Yılı listeden seçip gün ve ayı tamamlayabilir veya tarihi klavyeden yazabilirsiniz. Boş bırakırsanız “Belirsiz” görünür.</small>
                        <span asp-validation-for="HireDate" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field">
                        <span>İşten Çıkış Tarihi</span>
                        <input asp-for="TerminationDate" type="date" min="1900-01-01" class="announcement-form-input" />
                        <select class="announcement-form-input" data-date-year-select="true" data-date-year-target="TerminationDate" aria-label="İşten çıkış yılına hızlı git">
                            <option value="">Hızlı yıl seçin</option>
                            @for (var year = currentYear + 5; year >= 1900; year--)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                        <small class="admin-portal-user-field-note">İşten çıkış tarihi girildiğinde kullanıcı durumu Pasif seçilmelidir.</small>
                        <span asp-validation-for="TerminationDate" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field">
                        <span>Doğum Tarihi</span>
                        <input asp-for="BirthDate" type="date" min="1900-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="announcement-form-input" />
                        <select class="announcement-form-input" data-date-year-select="true" data-date-year-target="BirthDate" aria-label="Doğum yılına hızlı git">
                            <option value="">Hızlı yıl seçin</option>
                            @for (var year = currentYear; year >= 1900; year--)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                        <small class="admin-portal-user-field-note">Yılı listeden seçip gün ve ayı tamamlayabilir veya tarihi klavyeden yazabilirsiniz. Boş bırakırsanız “Belirsiz” görünür.</small>
                        <span asp-validation-for="BirthDate" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field admin-portal-user-location-field">
                        <span>Lokasyonlar</span>
                        <div class="admin-portal-user-location-options" role="group" aria-label="Kullanıcının lokasyonları">
                            @foreach (var locationOption in Model.LocationOptions)
                            {
                                var isSelected = int.TryParse(locationOption.Value, out var locationId) && Model.LocationIds.Contains(locationId);
                                <label class="admin-portal-user-location-option">
                                    <input type="checkbox"
                                           name="LocationIds"
                                           value="@locationOption.Value"
                                           data-manager-location-input="true"
                                           checked="@(isSelected ? "checked" : null)" />
                                    <span>@locationOption.Text</span>
                                </label>
                            }
                        </div>
                        <small class="admin-portal-user-field-note">Kullanıcının bağlı olduğu lokasyonların tamamını işaretleyebilirsiniz.</small>
                        <div class="admin-portal-user-location-warning"
                             data-manager-location-warning="true"
                             role="status"
                             hidden>
                            <strong>Birden fazla okul seçildi.</strong>
                            <span>Bu müdür, seçili okulların tamamındaki izin ve mesai taleplerini görebilecek.</span>
                        </div>
                        <span asp-validation-for="LocationIds" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field leave-detail-field--full">
                        <span>Adres</span>
                        <textarea asp-for="AddressText" class="announcement-form-input profile-edit-textarea" rows="4"></textarea>
                    </div>

                    <div class="leave-detail-field">
                        <span>Medeni Durum</span>
                        <select asp-for="MaritalStatus" class="announcement-form-input" asp-items="Html.GetEnumSelectList<MaritalStatusType>()">
                            <option value="">Seçiniz</option>
                        </select>
                    </div>

                    <div class="leave-detail-field">
                        <span>Üniversite</span>
                        <input asp-for="EducationUniversity" class="announcement-form-input" />
                    </div>

                    <div class="leave-detail-field">
                        <span>Fakülte</span>
                        <input asp-for="EducationFaculty" class="announcement-form-input" />
                    </div>

                    <div class="leave-detail-field">
                        <span>Bölüm</span>
                        <input asp-for="EducationDepartment" class="announcement-form-input" />
                    </div>

                    <div class="leave-detail-field">
                        <span>İzin Hakkı</span>
                        <input asp-for="LeaveDays" type="number" step="0.5" min="0" class="announcement-form-input" />
                        <small class="admin-portal-user-field-note">Mevcut değer: @FormatLeaveDays(Model.LeaveDays) Gün</small>
                        <span asp-validation-for="LeaveDays" class="announcement-form-validation"></span>
                    </div>

                    <div class="leave-detail-field">
                        <span>Durum</span>
                        <select asp-for="IsDeleted" class="announcement-form-input">
                            <option value="false">Aktif</option>
                            <option value="true">Pasif</option>
                        </select>
                    </div>
                </div>

                <div class="admin-portal-user-meta">
                    <div class="leave-detail-field">
                        <span>Kullanıcı</span>
                        <strong>@Model.FullName</strong>
                    </div>

                    <div class="leave-detail-field">
                        <span>Admin</span>
                        <select asp-for="IsAdmin" class="announcement-form-input">
                            <option value="false">Hayır</option>
                            <option value="true">Evet</option>
                        </select>
                    </div>

                    <div class="leave-detail-field">
                        <span>Lokasyon Müdürü</span>
                        <select asp-for="IsManager" class="announcement-form-input">
                            <option value="false">Hayır</option>
                            <option value="true">Evet</option>
                        </select>
                        <small class="admin-portal-user-field-note">Müdür, seçili lokasyonlardaki izin ve mesai taleplerinin ilk onayını verir.</small>
                    </div>
                </div>

                <div class="profile-edit-section">
                    <div class="profile-card__header">
                        <span class="profile-card__eyebrow">Aile</span>
                        <h2>Çocuk Bilgileri</h2>
                    </div>

                    <div class="profile-children-editor">
                        <div class="profile-children-list" data-child-list="true">
                            @for (var index = 0; index < Model.Children.Count; index++)
                            {
                                <div class="profile-child-row" data-child-row="true">
                                    <div class="profile-child-row__head">
                                        <strong data-child-label="true">Çocuk @(index + 1)</strong>
                                        <button type="button" class="home-link-pill" data-remove-child="true">Kaldır</button>
                                    </div>

                                    <div class="leave-detail-grid profile-edit-grid">
                                        <div class="leave-detail-field">
                                            <span>Adı</span>
                                            <input type="text" class="announcement-form-input" data-field="Name" maxlength="100" value="@Model.Children[index].Name" />
                                        </div>

                                        <div class="leave-detail-field">
                                            <span>Cinsiyet</span>
                                            <select class="announcement-form-input" data-field="Gender">
                                                <option value="">Seçiniz</option>
                                                @foreach (var option in Html.GetEnumSelectList<ChildGenderType>())
                                                {
                                                    if (option.Value == ((int?)Model.Children[index].Gender)?.ToString())
                                                    {
                                                        <option value="@option.Value" selected="selected">@option.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@option.Value">@option.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>

                                        <div class="leave-detail-field">
                                            <span>Doğum Tarihi</span>
                                            <input type="date" class="announcement-form-input" data-field="BirthDate" value="@Model.Children[index].BirthDate?.ToString("yyyy-MM-dd")" />
                                        </div>

                                        <div class="leave-detail-field">
                                            <span>Eğitim Durumu</span>
                                            <select class="announcement-form-input" data-field="EducationStatus">
                                                <option value="">Seçiniz</option>
                                                @foreach (var option in Html.GetEnumSelectList<ChildEducationStatusType>())
                                                {
                                                    if (option.Value == ((int?)Model.Children[index].EducationStatus)?.ToString())
                                                    {
                                                        <option value="@option.Value" selected="selected">@option.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@option.Value">@option.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <template data-child-template="true">
                            <div class="profile-child-row" data-child-row="true">
                                <div class="profile-child-row__head">
                                    <strong data-child-label="true">Çocuk</strong>
                                    <button type="button" class="home-link-pill" data-remove-child="true">Kaldır</button>
                                </div>

                                <div class="leave-detail-grid profile-edit-grid">
                                    <div class="leave-detail-field">
                                        <span>Adı</span>
                                        <input type="text" class="announcement-form-input" data-field="Name" maxlength="100" value="" />
                                    </div>

                                    <div class="leave-detail-field">
                                        <span>Cinsiyet</span>
                                        <select class="announcement-form-input" data-field="Gender">
                                            <option value="">Seçiniz</option>
                                            @foreach (var option in Html.GetEnumSelectList<ChildGenderType>())
                                            {
                                                <option value="@option.Value">@option.Text</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="leave-detail-field">
                                        <span>Doğum Tarihi</span>
                                        <input type="date" class="announcement-form-input" data-field="BirthDate" value="" />
                                    </div>

                                    <div class="leave-detail-field">
                                        <span>Eğitim Durumu</span>
                                        <select class="announcement-form-input" data-field="EducationStatus">
                                            <option value="">Seçiniz</option>
                                            @foreach (var option in Html.GetEnumSelectList<ChildEducationStatusType>())
                                            {
                                                <option value="@option.Value">@option.Text</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </template>

                        <div class="profile-children-actions">
                            <button type="button" class="leave-history-topbar__action" data-add-child="true">Çocuk Ekle +</button>
                        </div>
                    </div>
                </div>

                <div class="admin-leave-detail-actions">
                    <button type="submit" class="announcement-form-actions__save">Kaydet</button>
                    <a asp-controller="Admin" asp-action="PortalUsers" class="announcement-form-actions__cancel">İptal</a>
                </div>
            </form>
        </div>
    </div>
</section>

@if (!Model.HasLoanRecords)
{
    <div class="modal fade" id="noLoanRecordsModal" tabindex="-1" aria-labelledby="noLoanRecordsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content admin-portal-user-no-loan-modal">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="noLoanRecordsModalLabel">Zimmet Bilgisi</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p>Bu kişide kayıtlı zimmet yok.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="announcement-form-actions__save" data-bs-dismiss="modal">Tamam</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade"
     id="multipleManagerLocationsModal"
     tabindex="-1"
     aria-labelledby="multipleManagerLocationsModalLabel"
     aria-describedby="multipleManagerLocationsModalDescription"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-portal-user-manager-location-modal">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="multipleManagerLocationsModalLabel">Birden Fazla Okul Ataması</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p id="multipleManagerLocationsModalDescription">
                    Müdürü başka bir okula da atamak istiyor musunuz? Bu müdür, seçili okulların tamamındaki izin ve mesai taleplerini görebilecek.
                </p>
                <div class="admin-portal-user-manager-location-modal__schools">
                    <strong>Seçili okullar</strong>
                    <span data-manager-location-summary="true"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="announcement-form-actions__cancel" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button"
                        class="announcement-form-actions__save"
                        data-confirm-manager-locations="true">Evet, atamayı kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var statusSelect = document.getElementById("IsDeleted");
            var acknowledgement = document.getElementById("ActiveLoanWarningAccepted");
            var warning = document.querySelector("[data-active-loan-warning='true']");

            if (!statusSelect || !acknowledgement || !warning) {
                return;
            }

            function syncLoanWarningRequirement() {
                var isPassive = statusSelect.value === "true";
                acknowledgement.required = isPassive;
                warning.classList.toggle("is-required", isPassive);
            }

            statusSelect.addEventListener("change", syncLoanWarningRequirement);
            syncLoanWarningRequirement();
        })();

        (function () {
            var form = document.querySelector("[data-manager-location-form='true']");
            var managerSelect = document.getElementById("IsManager");
            var locationInputs = Array.from(document.querySelectorAll("[data-manager-location-input='true']"));
            var warning = document.querySelector("[data-manager-location-warning='true']");
            var modalElement = document.getElementById("multipleManagerLocationsModal");
            var locationSummary = document.querySelector("[data-manager-location-summary='true']");
            var confirmButton = document.querySelector("[data-confirm-manager-locations='true']");

            if (!form || !managerSelect || !locationInputs.length || !warning || !modalElement || !locationSummary || !confirmButton) {
                return;
            }

            var initialManagerValue = managerSelect.value;
            var initialLocationSignature = getSelectedLocations()
                .map(function (item) { return item.value; })
                .sort()
                .join(",");
            var multipleLocationsConfirmed = false;

            function getSelectedLocations() {
                return locationInputs
                    .filter(function (input) { return input.checked; })
                    .map(function (input) {
                        var label = input.closest("label");
                        var labelText = label ? label.querySelector("span") : null;

                        return {
                            value: input.value,
                            name: labelText ? labelText.textContent.trim() : input.value
                        };
                    });
            }

            function isManager() {
                return managerSelect.value === "true";
            }

            function hasManagerAssignmentChanged(selectedLocations) {
                var currentSignature = selectedLocations
                    .map(function (item) { return item.value; })
                    .sort()
                    .join(",");

                return initialManagerValue !== managerSelect.value || initialLocationSignature !== currentSignature;
            }

            function syncMultipleLocationWarning() {
                var shouldWarn = isManager() && getSelectedLocations().length > 1;
                warning.hidden = !shouldWarn;
            }

            function resetConfirmation() {
                multipleLocationsConfirmed = false;
                syncMultipleLocationWarning();
            }

            locationInputs.forEach(function (input) {
                input.addEventListener("change", resetConfirmation);
            });
            managerSelect.addEventListener("change", resetConfirmation);

            form.addEventListener("submit", function (event) {
                var selectedLocations = getSelectedLocations();
                var requiresConfirmation = isManager()
                    && selectedLocations.length > 1
                    && hasManagerAssignmentChanged(selectedLocations);

                if (!requiresConfirmation || multipleLocationsConfirmed) {
                    return;
                }

                event.preventDefault();
                locationSummary.textContent = selectedLocations
                    .map(function (item) { return item.name; })
                    .join(", ");

                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            });

            confirmButton.addEventListener("click", function () {
                multipleLocationsConfirmed = true;
                bootstrap.Modal.getOrCreateInstance(modalElement).hide();
                form.requestSubmit();
            });

            syncMultipleLocationWarning();
        })();
    </script>
}
