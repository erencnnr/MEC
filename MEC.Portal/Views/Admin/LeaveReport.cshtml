@{
    ViewData["Title"] = "İzin Raporu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="leave-history-page admin-leave-page">
    <div class="leave-history-shell">
        <div class="leave-history-topbar">
            <div>
                <span class="leave-history-topbar__eyebrow">Yönetici işlemleri</span>
                <h1>İzin Raporu</h1>
                <p>Bu alan izin raporlama ekranı için ayrıldı. İçerik bir sonraki geliştirmede hazırlanacak.</p>
            </div>
        </div>

        <div class="leave-history-empty admin-leave-report-card">
            <h2>Rapor ekranı hazırlanıyor</h2>
            <p>İzin kırılımları, dönemsel özetler ve dışa aktarma seçenekleri bu sayfaya eklenecek.</p>
        </div>
    </div>
</section>
