@using System.Globalization
@model List<MEC.Portal.Models.AdminLeaveRequestViewModel>

@{
    ViewData["Title"] = "İzin Talepleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string FormatLeaveDays(decimal value)
    {
        return value.ToString("0.##", CultureInfo.GetCultureInfo("tr-TR"));
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4">Personel İzin Talepleri</h2>
    <span class="badge bg-primary">Toplam: @Model.Count</span>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 14%">Personel</th>
                    <th style="width: 15%">İzin Türü</th>
                    <th style="width: 10%">Gün</th>
                    <th style="width: 15%">Başlangıç</th>
                    <th style="width: 15%">Bitiş</th>
                    <th style="width: 15%">Açıklama</th>
                    <th style="width: 10%">Durum</th>
                    <th style="width: 10%">Kalan</th>
                    <th style="width: 10%" class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Kayıtlı izin talebi bulunamadı.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.EmployeeName</td>
                            <td>@item.LeaveType</td>
                            <td>@FormatLeaveDays(item.RequestedDays) Gün</td>
                            <td>@item.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.EndDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><small class="text-muted">@item.Reason</small></td>
                            <td>
                                @if (item.Status == 0)
                                {
                                    <span class="badge bg-warning text-dark">Bekliyor</span>
                                }
                                else if (item.Status == 1)
                                {
                                    <span class="badge bg-success">Onaylandı</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Reddedildi</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == 1)
                                {
                                    <span class="badge @(item.RemainingLeaveDays < 0 ? "bg-danger" : "bg-info")">@FormatLeaveDays(item.RemainingLeaveDays) Gün</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Status == 0)
                                {
                                    <div class="d-flex justify-content-center gap-2">
                                        <form asp-controller="Admin" asp-action="UpdateLeaveStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="status" value="1" />
                                            <button type="submit" class="btn btn-outline-success btn-sm"
                                                    onclick="return confirm('Onaylamak istediğinize emin misiniz?');">
                                                Onayla
                                            </button>
                                        </form>

                                        <form asp-controller="Admin" asp-action="UpdateLeaveStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="status" value="2" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Reddetmek istediğinize emin misiniz?');">
                                                Reddet
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">İşlem Tamamlandı</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
