@model MEC.Portal.Models.LibraryIndexViewModel

@{
    ViewData["Title"] = "Kütüphane";
}

<section class="library-page">
    <div class="library-shell">
        <div class="library-topbar">
            <div>
                <span class="library-topbar__eyebrow">Kütüphane</span>
                <h1>Doküman merkezi</h1>
            </div>

            <form method="get" asp-controller="Library" asp-action="Index" class="library-document-search" role="search">
                @if (Model.SelectedFolderId.HasValue)
                {
                    <input type="hidden" name="folderId" value="@Model.SelectedFolderId.Value" />
                }
                <label class="visually-hidden" for="libraryDocumentSearch">Doküman ara</label>
                <div class="library-document-search__controls">
                    <input id="libraryDocumentSearch"
                           name="search"
                           value="@Model.SearchTerm"
                           type="search"
                           maxlength="100"
                           autocomplete="off"
                           placeholder="Doküman veya klasör ara..." />
                    <button type="submit">Ara</button>
                    @if (Model.IsSearching)
                    {
                        <a asp-controller="Library"
                           asp-action="Index"
                           asp-route-folderId="@Model.SelectedFolderId">Temizle</a>
                    }
                </div>
            </form>
        </div>

        @if (TempData["LibraryError"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="library-alert library-alert--error">@errorMessage</div>
        }

        @if (Model.IsSearching)
        {
            <section class="library-card library-search-results-card" aria-live="polite">
                <div class="library-card__head library-card__head--split">
                    <div>
                        <span class="library-card__eyebrow">Arama sonuçları</span>
                        <h2>“@Model.SearchTerm”</h2>
                    </div>
                    <span class="library-card__meta">@Model.SearchResults.Count doküman</span>
                </div>

                @if (Model.SearchResults.Any())
                {
                    <div class="library-search-results">
                        @foreach (var result in Model.SearchResults)
                        {
                            <a class="library-search-result"
                               href="@result.OpenUrl"
                               target="_blank"
                               rel="noopener noreferrer">
                                <span class="library-search-result__type">@(result.IsPdf ? "PDF" : "Dosya")</span>
                                <span class="library-search-result__body">
                                    <strong>@result.Name</strong>
                                    <span>@(string.IsNullOrWhiteSpace(result.FolderPath) ? "Kütüphane" : result.FolderPath)</span>
                                </span>
                                <span class="library-search-result__meta">@result.MetaText</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="library-empty library-empty--compact">
                        <h3>Doküman bulunamadı</h3>
                        <p>Arama ifadesini değiştirerek tekrar deneyin.</p>
                    </div>
                }
            </section>
        }

        <div class="library-layout">
            <aside class="library-sidebar">
                <section class="library-card library-card--sidebar library-explorer">
                    <div class="library-card__head">
                        <div>
                            <span class="library-card__eyebrow">Klasörler</span>
                            <h2>İçerik ağacı</h2>
                        </div>
                    </div>

                    @if (Model.FolderTree.Any())
                    {
                        <nav class="library-tree" aria-label="Kütüphane klasörleri">
                            <ul class="library-tree__group">
                                @foreach (var folder in Model.FolderTree)
                                {
                                    @await Html.PartialAsync("_LibraryTreeNode", folder, new ViewDataDictionary(ViewData)
                                    {
                                        ["LibraryTreeBasePath"] = "/Library"
                                    })
                                }
                            </ul>
                        </nav>
                    }
                    else
                    {
                        <div class="library-empty library-empty--compact">
                            <h3>Henüz içerik yok</h3>
                            <p>Yönetim tarafından doküman eklendiğinde burada görüntülenecek.</p>
                        </div>
                    }
                </section>
            </aside>

            <div class="library-main">
                @if (Model.SelectedFolderId.HasValue)
                {
                    <section class="library-card">
                        <div class="library-card__head library-card__head--split">
                            <div>
                                <span class="library-card__eyebrow">Seçili klasör</span>
                                <h2>@Model.SelectedFolderName</h2>
                            </div>

                            @if (Model.Breadcrumbs.Any())
                            {
                                <nav class="library-breadcrumbs" aria-label="Klasör yolu">
                                    @foreach (var crumb in Model.Breadcrumbs)
                                    {
                                        <a href="/Library?folderId=@crumb.Id">@crumb.Name</a>
                                    }
                                </nav>
                            }
                        </div>

                        @if (Model.Items.Any())
                        {
                            <div class="library-content-grid">
                                @foreach (var item in Model.Items)
                                {
                                    <a class="library-content-tile @(item.IsFolder ? "is-folder" : "is-document")"
                                       href="@item.NavigateUrl"
                                       target="@(item.IsFolder ? null : "_blank")"
                                       rel="@(item.IsFolder ? null : "noopener noreferrer")">
                                        <span class="library-content-tile__icon" aria-hidden="true">
                                            @if (item.IsFolder)
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" role="presentation">
                                                    <path d="M3 7.5C3 6.67 3.67 6 4.5 6H9l1.4 1.8H19.5c.83 0 1.5.67 1.5 1.5V17c0 .83-.67 1.5-1.5 1.5h-15C3.67 18.5 3 17.83 3 17V7.5Z" fill="currentColor" opacity=".22"></path>
                                                    <path d="M3 8.25C3 7.01 4.01 6 5.25 6H9l1.35 1.5H18.75C19.99 7.5 21 8.51 21 9.75V16.75C21 17.99 19.99 19 18.75 19H5.25C4.01 19 3 17.99 3 16.75V8.25Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" role="presentation">
                                                    <path d="M7 3.75h7.2L19 8.55V19a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 6 19V5.25A1.5 1.5 0 0 1 7.5 3.75Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                                                    <path d="M14 3.75V8.5h4.75" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                                                    <path d="M8.75 14.25h6.5M8.75 17h4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                                                </svg>
                                            }
                                        </span>
                                        <span class="library-content-tile__body">
                                            <strong>@item.Name</strong>
                                            <span>@item.MetaText</span>
                                        </span>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="library-empty library-empty--compact">
                                <h3>Bu klasörde doküman yok</h3>
                                <p>Bu klasörde görüntülenecek alt klasör veya doküman bulunmuyor.</p>
                            </div>
                        }
                    </section>
                }
                else
                {
                    <section class="library-card">
                        <div class="library-empty">
                            <h2>Henüz görüntülenecek klasör yok</h2>
                            <p>Kütüphane içerikleri hazır olduğunda klasör yapısı ve dokümanlar burada listelenecek.</p>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</section>
