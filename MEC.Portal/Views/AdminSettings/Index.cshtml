@{
    ViewData["Title"] = "Ayarlar";
    ViewData["SettingsSection"] = "overview";
    Layout = "~/Views/Shared/_SettingsLayout.cshtml";
}

<section class="settings-overview">
    <header class="settings-overview__header">
        <span class="settings-overview__eyebrow">Yönetim Paneli</span>
        <h1>Ayarlar</h1>
        <p>Kullanıcı, okul, izin ve portal ayarlarını buradan yönetin.</p>
    </header>
    <div class="settings-overview__groups">
        @foreach (var group in AdminSettingsNavigation.Groups)
        {
            <section class="settings-overview__group">
                <h2>@group.Title</h2>
                <div class="settings-overview__links">
                    @foreach (var item in group.Links)
                    {
                        <a class="settings-overview__link" href="@item.Url">
                            <span>@item.Title</span>
                            <small>@item.Description</small>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
</section>
