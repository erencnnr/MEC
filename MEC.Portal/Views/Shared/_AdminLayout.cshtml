@{
    // Ana layout'un özelliklerini (CSS, JS, Header) miras alması için _Layout'u çağırıyoruz
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="row">

        <main class="col-md-9 col-lg-10 px-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    @RenderBody()
                </div>
            </div>
        </main>

        <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar rounded shadow-sm py-3">
            <div class="position-sticky">
                <h5 class="text-center border-bottom pb-2 mb-3">Admin Menüsü</h5>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2">
                        <a class="nav-link text-dark bg-white rounded shadow-sm" asp-controller="Admin" asp-action="Index">
                            📌 Admin Dashboard
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link text-dark bg-white rounded shadow-sm" asp-controller="Admin" asp-action="Announcements">
                            📢 Duyuru Yönetimi
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link text-dark bg-white rounded shadow-sm" asp-controller="Admin" asp-action="LeaveRequests">
                            📅 İzin Talepleri
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

    </div>
</div>