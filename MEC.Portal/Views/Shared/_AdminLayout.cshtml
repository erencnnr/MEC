@{
    Layout = "_Layout";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string NavState(string controller, string action)
    {
        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
               string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "admin-nav__link is-active"
            : "admin-nav__link";
    }
}

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-sidebar__panel">
            <div class="admin-sidebar__brand">
                <span class="admin-sidebar__eyebrow">MEC Portal</span>
                <h2>Admin Panel</h2>
                <p>Yönetim işlemlerini tek ekrandan hızlıca yönetin.</p>
            </div>

            <div class="admin-sidebar__summary">
                <span class="admin-sidebar__summary-label">Aktif oturum</span>
                <strong>@(User.Identity?.Name ?? "Admin")</strong>
            </div>

            <nav class="admin-nav">
                <a class="@NavState("Admin", "Index")" asp-controller="Admin" asp-action="Index">
                    <span class="admin-nav__title">Yönetim Paneli</span>
                    <span class="admin-nav__description">Genel yönetim ve hızlı geçişler</span>
                </a>

                <a class="@NavState("Admin", "Announcements")" asp-controller="Admin" asp-action="Announcements">
                    <span class="admin-nav__title">Duyuru Yönetimi</span>
                    <span class="admin-nav__description">Portal duyurularını oluştur ve güncelle</span>
                </a>

                <a class="@NavState("Admin", "LeaveRequests")" asp-controller="Admin" asp-action="LeaveRequests">
                    <span class="admin-nav__title">İzin Talepleri</span>
                    <span class="admin-nav__description">Bekleyen izin isteklerini incele</span>
                </a>
            </nav>
        </div>
    </aside>

    <main class="admin-content">
        <div class="admin-content__surface">
            @RenderBody()
        </div>
    </main>
</div>
