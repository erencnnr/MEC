@model MEC.Application.Service.LeaveService.DecisionDetails
<link rel="stylesheet" href="~/css/leave-accounting.css" />
<div class="leave-accounting">
@if(TempData["AccountingMessage"] is string message){<p role="status">@message</p>}
@if(Model.Previous.Count>0){<h2>Bu türdeki önceki talepler</h2><p>Aynı olay için daha önce izin kullanılıp kullanılmadığını kontrol edin.</p><ul>@foreach(var previous in Model.Previous){<li>@previous.StartDate.ToString("dd.MM.yyyy") / @previous.EndDate.ToString("dd.MM.yyyy") · @previous.RequestedDays gün · @((MEC.Domain.Common.Enum.LeaveStatus)previous.Status)</li>}</ul>}
@if(Model.CanRequestCancellation){<form action="/Leave/History/@Model.Leave.Id/RequestCancellation" method="post">@Html.AntiForgeryToken()<label>İptal gerekçesi<input name="reason" maxlength="1000" required /></label><button>İptal onayı iste</button></form>}
@if(Model.Cancellation is {} request){<p>İptal talebi: @(request.Status switch { "Pending"=>"Onay bekliyor", "Approved"=>"Kabul edildi", "Rejected"=>"Reddedildi", _=>"Süresi geçti" }) · @request.Reason</p>}
@if(Model.CanDecideCancellation){<form action="/Admin/LeaveCancellations/@Model.Leave.Id/Decision" method="post">@Html.AntiForgeryToken()<button name="approve" value="true">İptali onayla ve günleri iade et</button><button name="approve" value="false">İptal talebini reddet</button></form>}
@if(Model.CanReviewHistorical){<details><summary>Mutabakat öncesindeki izin incelemesi</summary><form action="/Admin/LeaveAccounts/ReviewHistorical" method="post">@Html.AntiForgeryToken()<input type="hidden" name="leaveId" value="@Model.Leave.Id" /><label>Mutabakatta hesaba katıldı mı?<select name="included"><option value="true">Evet, tekrar düşülmesin</option><option value="false">Hayır, onayda düşülsün</option></select></label><label>İnceleme gerekçesi<input name="reason" required maxlength="1000" /></label><button>İncelemeyi kaydet</button></form></details>}
@if(Model.CanReviewSplit){<details><summary>Eski iznin mutabakat sınırındaki günlerini doğrula</summary><p>Eski hesaplama kuralları bulunamayan izinlerde, mutabakat günü dahil önceki kısmı girin. Kalan kısım toplam gün sayısından hesaplanır.</p><form action="/Admin/LeaveAccounts/ReviewSplit" method="post">@Html.AntiForgeryToken()<input type="hidden" name="leaveId" value="@Model.Leave.Id" /><label>Mutabakat tarihi<input type="date" name="cutoff" required /></label><label>Bu tarihe kadar dahil gün<input type="number" name="before" min="0" max="@Model.Leave.RequestedDays.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.5" required /></label><label>Gerekçe<input name="reason" maxlength="1000" required /></label><button>Gün dağılımını doğrula</button></form></details>}
</div>
