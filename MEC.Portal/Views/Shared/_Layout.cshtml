<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | MEC Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentPath = ViewContext.HttpContext.Request.Path.Value ?? string.Empty;
        var givenName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
        var surname = User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value;
        var fullName = string.Join(" ", new[] { givenName, surname }.Where(x => !string.IsNullOrWhiteSpace(x))).Trim();
        var welcomeName = !string.IsNullOrWhiteSpace(fullName) ? fullName : (User.Identity?.Name ?? "Kullanıcı");

        var isAdminAnnouncementPage = currentPath.StartsWith("/Admin/Announcements", StringComparison.OrdinalIgnoreCase);
        var isAdminNewsPage = currentPath.StartsWith("/Admin/News", StringComparison.OrdinalIgnoreCase);
        var isAdminLeaveRequestsPage = currentPath.Equals("/Admin/LeaveRequests", StringComparison.OrdinalIgnoreCase) ||
                                       currentPath.StartsWith("/Admin/LeaveRequests/", StringComparison.OrdinalIgnoreCase);
        var isAdminLeaveReportPage = currentPath.Equals("/Admin/LeaveReport", StringComparison.OrdinalIgnoreCase);
        var isAdminLeaveAgreementPage = currentPath.Equals("/Admin/LeaveAgreement", StringComparison.OrdinalIgnoreCase) ||
                                        currentPath.StartsWith("/Admin/LeaveAgreement/", StringComparison.OrdinalIgnoreCase);
        var isAdminLeavePolicyPage = currentPath.Equals("/Admin/LeavePolicy", StringComparison.OrdinalIgnoreCase) ||
                                     currentPath.StartsWith("/Admin/LeavePolicy/", StringComparison.OrdinalIgnoreCase);
        var isAdminLeaveBalancesPage = currentPath.Equals("/Admin/LeaveBalances", StringComparison.OrdinalIgnoreCase);
        var isAdminOvertimeReportPage = currentPath.Equals("/Admin/OvertimeReport", StringComparison.OrdinalIgnoreCase);
        var isAdminPortalUsersPage = currentPath.Equals("/Admin/PortalUsers", StringComparison.OrdinalIgnoreCase) ||
                                     currentPath.StartsWith("/Admin/PortalUsers/", StringComparison.OrdinalIgnoreCase);
        var isAdminSliderPage = currentPath.Equals("/Admin/Slider", StringComparison.OrdinalIgnoreCase);
        var isAdminBirthdayPopupPage = currentPath.Equals("/Admin/BirthdayPopup", StringComparison.OrdinalIgnoreCase) ||
                                       currentPath.StartsWith("/Admin/BirthdayPopup/", StringComparison.OrdinalIgnoreCase);
        var isAdminFoodMenuPage = currentPath.Equals("/Admin/FoodMenu", StringComparison.OrdinalIgnoreCase) ||
                                  currentPath.StartsWith("/Admin/FoodMenu/", StringComparison.OrdinalIgnoreCase);
        var isAdminSurveyPage = currentPath.Equals("/Admin/Surveys", StringComparison.OrdinalIgnoreCase) ||
                                currentPath.StartsWith("/Admin/Surveys/", StringComparison.OrdinalIgnoreCase);
        var isAdminContentPage = currentPath.Equals("/Admin/Content", StringComparison.OrdinalIgnoreCase) ||
                                 currentPath.StartsWith("/Admin/Content/", StringComparison.OrdinalIgnoreCase);
        var isAdminAssetsPage = currentPath.Equals("/Admin/Assets", StringComparison.OrdinalIgnoreCase) ||
                                currentPath.StartsWith("/Admin/Assets/", StringComparison.OrdinalIgnoreCase);
        var isAdminLoansPage = currentPath.Equals("/Admin/Loans", StringComparison.OrdinalIgnoreCase) ||
                               currentPath.StartsWith("/Admin/Loans/", StringComparison.OrdinalIgnoreCase);
        var isAdminOvertimeRequestsPage = currentPath.Equals("/Admin/OvertimeRequests", StringComparison.OrdinalIgnoreCase) ||
                                          currentPath.StartsWith("/Admin/OvertimeRequests/", StringComparison.OrdinalIgnoreCase);
        var isOvertimePage = string.Equals(currentController, "Overtime", StringComparison.OrdinalIgnoreCase);
        var isLibraryPage = currentPath.Equals("/Library", StringComparison.OrdinalIgnoreCase) ||
                            currentPath.StartsWith("/Library/", StringComparison.OrdinalIgnoreCase);
        var isAdminLeavePage = isAdminLeaveRequestsPage || isAdminLeaveReportPage || isAdminLeaveAgreementPage || isAdminLeavePolicyPage || isAdminLeaveBalancesPage;
        var isAdminSettingsPage = isAdminPortalUsersPage || isAdminSliderPage || isAdminBirthdayPopupPage || isAdminFoodMenuPage || isAdminSurveyPage;
        var isAdminInventoryPage = isAdminAssetsPage || isAdminLoansPage;
        var isAdminOvertimePage = isAdminOvertimeRequestsPage || isAdminOvertimeReportPage;
        var isAnnouncementPage =
            currentPath.Equals("/Announcements", StringComparison.OrdinalIgnoreCase) ||
            currentPath.StartsWith("/Announcements/", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
            string.Equals(currentAction, "Announcements", StringComparison.OrdinalIgnoreCase);
        var isNewsPage =
            currentPath.Equals("/News", StringComparison.OrdinalIgnoreCase) ||
            currentPath.StartsWith("/News/", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
            string.Equals(currentAction, "News", StringComparison.OrdinalIgnoreCase);

        var isAdminPage = string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase) ||
                          isAdminAnnouncementPage ||
                          isAdminNewsPage ||
                          isAdminLeavePage ||
                          isAdminSettingsPage ||
                          isAdminContentPage ||
                          isAdminInventoryPage ||
                          isAdminOvertimePage;
        var isLeavePage = string.Equals(currentController, "Leave", StringComparison.OrdinalIgnoreCase);
        var isAdminUser = User.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
        var isApprovalUser = User.Identity?.IsAuthenticated == true &&
                             (User.IsInRole("Manager") || User.IsInRole("FinalApprover"));

        bool HeaderRouteMatch(string controller, params string[] actions)
        {
            if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            foreach (var action in actions)
            {
                if (string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }
            }

            return false;
        }

        string HeaderNavState(string controller, params string[] actions)
        {
            return HeaderRouteMatch(controller, actions)
                ? "portal-header__nav-link is-active"
                : "portal-header__nav-link";
        }
    }

    <header>
        <nav class="navbar navbar-expand-lg portal-header mb-4">
            <div class="container-fluid px-4 portal-header__inner">
                <a class="navbar-brand portal-header__brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="portal-header__brand-mark">
                        <img src="~/content/images/logo.png" alt="MEC Logo" />
                    </span>
                    <span class="portal-header__brand-text">
                        <strong>MEC Portal</strong>
                    </span>
                </a>

                <button class="navbar-toggler portal-header__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="portal-header__content">
                        <div class="portal-header__nav">
                            <a class="@HeaderNavState("Home", "Index")" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                            <a class="@(isAnnouncementPage ? "portal-header__nav-link is-active" : "portal-header__nav-link")" asp-controller="Home" asp-action="Announcements">Duyurular</a>
                            <a class="@(isNewsPage ? "portal-header__nav-link is-active" : "portal-header__nav-link")" asp-controller="Home" asp-action="News">Haberler</a>

                            <div class="dropdown portal-header__nav-dropdown @(isLeavePage ? "is-active" : string.Empty)">
                                <button class="portal-header__nav-link portal-header__nav-dropdown-toggle dropdown-toggle portal-header__nav-link--action @(isLeavePage ? "is-active" : string.Empty)" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    İzin İşlemleri
                                </button>
                                <div class="dropdown-menu portal-header__nav-dropdown-menu">
                                    <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Leave", "RequestLeave") ? "is-active" : string.Empty)" asp-controller="Leave" asp-action="RequestLeave">İzin Talebi Oluştur</a>
                                    <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Leave", "History", "HistoryDetail") ? "is-active" : string.Empty)" asp-controller="Leave" asp-action="History">İzin Geçmişim</a>
                                </div>
                            </div>

                            <div class="dropdown portal-header__nav-dropdown @(isOvertimePage ? "is-active" : string.Empty)">
                                <button class="portal-header__nav-link portal-header__nav-dropdown-toggle dropdown-toggle portal-header__nav-link--action @(isOvertimePage ? "is-active" : string.Empty)" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Mesai İşlemleri
                                </button>
                                <div class="dropdown-menu portal-header__nav-dropdown-menu">
                                    <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Overtime", "Request") ? "is-active" : string.Empty)" asp-controller="Overtime" asp-action="Request">Mesai Talebi Oluştur</a>
                                    <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Overtime", "History", "HistoryDetail") ? "is-active" : string.Empty)" asp-controller="Overtime" asp-action="History">Mesai Geçmişim</a>
                                </div>
                            </div>

                            <a class="@(isLibraryPage ? "portal-header__nav-link is-active" : "portal-header__nav-link")" asp-controller="Library" asp-action="Index">Kütüphane</a>

                            @if (isAdminUser)
                            {
                                <div class="dropdown portal-header__nav-dropdown @(isAdminPage ? "is-active" : string.Empty)">
                                    <button class="portal-header__nav-link portal-header__nav-dropdown-toggle dropdown-toggle @(isAdminPage ? "is-active" : string.Empty)" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Yönetim Paneli
                                    </button>
                                    <div class="dropdown-menu portal-header__nav-dropdown-menu">
                                        <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Admin", "Index") ? "is-active" : string.Empty)" asp-controller="Admin" asp-action="Index">Genel Bakış</a>
                                        <a class="portal-header__nav-dropdown-item @(isAdminAnnouncementPage ? "is-active" : string.Empty)" asp-controller="Announcement" asp-action="Index">Duyuru Yönetimi</a>
                                        <a class="portal-header__nav-dropdown-item @(isAdminNewsPage ? "is-active" : string.Empty)" asp-controller="News" asp-action="Index">Haber Yönetimi</a>
                                        <a class="portal-header__nav-dropdown-item @(isAdminContentPage ? "is-active" : string.Empty)" asp-controller="Content" asp-action="Index">İçerik Yönetimi</a>

                                        <div class="portal-header__nav-submenu">
                                            <button class="portal-header__nav-dropdown-item portal-header__nav-submenu-toggle" type="button">
                                                Zimmet Yönetimi
                                            </button>
                                            <div class="portal-header__nav-submenu-menu">
                                                <a class="portal-header__nav-submenu-item" asp-controller="Assets" asp-action="Index">Envanter</a>
                                                <a class="portal-header__nav-submenu-item" asp-controller="Loans" asp-action="Index">Zimmetler</a>
                                            </div>
                                        </div>

                                        <div class="portal-header__nav-submenu">
                                            <button class="portal-header__nav-dropdown-item portal-header__nav-submenu-toggle" type="button">
                                                İzinler
                                            </button>
                                            <div class="portal-header__nav-submenu-menu">
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="LeaveRequests">İzin Talepleri</a>
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="LeaveReport">İzin Raporu</a>
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="LeaveBalances">İzin Bakiyeleri</a>
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="LeaveAgreement">İzin Mutabakat</a>
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="LeavePolicy">İzin Politikası</a>
                                            </div>
                                        </div>

                                        <div class="portal-header__nav-submenu">
                                            <button class="portal-header__nav-dropdown-item portal-header__nav-submenu-toggle" type="button">
                                                Mesailer
                                            </button>
                                            <div class="portal-header__nav-submenu-menu">
                                                <a class="portal-header__nav-submenu-item" href="/Admin/OvertimeRequests">Mesai Talepleri</a>
                                                <a class="portal-header__nav-submenu-item" href="/Admin/OvertimeReport">Mesai Raporu</a>
                                            </div>
                                        </div>

                                        <div class="portal-header__nav-submenu">
                                            <button class="portal-header__nav-dropdown-item portal-header__nav-submenu-toggle" type="button">
                                                Ayarlar
                                            </button>
                                            <div class="portal-header__nav-submenu-menu">
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="PortalUsers">Portal Kullanıcıları</a>
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="Slider">Slider</a>
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="BirthdayPopup">Doğum Günü Popup</a>
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="FoodMenu">Yemek Menüsü</a>
                                                <a class="portal-header__nav-submenu-item" asp-controller="Admin" asp-action="Surveys">Anket Yönetimi</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (isApprovalUser)
                            {
                                <div class="dropdown portal-header__nav-dropdown @(isAdminLeaveRequestsPage || isAdminLeaveBalancesPage || isAdminOvertimeRequestsPage ? "is-active" : string.Empty)">
                                    <button class="portal-header__nav-link portal-header__nav-dropdown-toggle dropdown-toggle @(isAdminLeaveRequestsPage || isAdminLeaveBalancesPage || isAdminOvertimeRequestsPage ? "is-active" : string.Empty)" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Onay İşlemleri
                                    </button>
                                    <div class="dropdown-menu portal-header__nav-dropdown-menu">
                                        <a class="portal-header__nav-dropdown-item @(isAdminLeaveRequestsPage ? "is-active" : string.Empty)" asp-controller="Admin" asp-action="LeaveRequests">İzin Talepleri</a>
                                        <a class="portal-header__nav-dropdown-item @(isAdminLeaveBalancesPage ? "is-active" : string.Empty)" asp-controller="Admin" asp-action="LeaveBalances">İzin Bakiyeleri</a>
                                        <a class="portal-header__nav-dropdown-item @(isAdminOvertimeRequestsPage ? "is-active" : string.Empty)" href="/Admin/OvertimeRequests">Mesai Talepleri</a>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="portal-header__actions">
                            <span class="portal-header__welcome">Hoş geldiniz, @welcomeName</span>
                            <div class="portal-header__icon-links">
                                <a class="@(HeaderRouteMatch("Profile", "Index", "Edit") ? "portal-header__icon-link is-active" : "portal-header__icon-link")"
                                   asp-controller="Profile"
                                   asp-action="Index"
                                   aria-label="Profilim">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-3.86 0-7 2.24-7 5v1h2v-1c0-1.64 2.24-3 5-3s5 1.36 5 3v1h2v-1c0-2.76-3.14-5-7-5Z" />
                                    </svg>
                                </a>
                                <a class="portal-header__icon-link portal-header__icon-link--logout"
                                   asp-controller="Account"
                                   asp-action="Logout"
                                   aria-label="Çıkış Yap">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5v-2H5V6h5Zm7.59 7-2.3-2.29L16.7 7.3 21.41 12l-4.71 4.7-1.41-1.41L17.59 13H9v-2Z" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
