<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | MEC Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isAdminPage = string.Equals(currentController, "Admin", System.StringComparison.OrdinalIgnoreCase);
        var isLeavePage = string.Equals(currentController, "Leave", System.StringComparison.OrdinalIgnoreCase);
        var isAdminUser = User.Identity.IsAuthenticated && User.IsInRole("Admin");

        bool HeaderRouteMatch(string controller, params string[] actions)
        {
            if (!string.Equals(currentController, controller, System.StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            foreach (var action in actions)
            {
                if (string.Equals(currentAction, action, System.StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }
            }

            return false;
        }

        string HeaderNavState(string controller, params string[] actions)
        {
            return HeaderRouteMatch(controller, actions)
                ? "portal-header__nav-link is-active"
                : "portal-header__nav-link";
        }
    }

    <header>
        <nav class="navbar navbar-expand-lg portal-header mb-4">
            <div class="container-fluid px-4 portal-header__inner">
                <a class="navbar-brand portal-header__brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="portal-header__brand-mark">
                        <img src="~/content/images/logo.png" alt="MEC Logo" />
                    </span>
                    <span class="portal-header__brand-text">
                        <strong>MEC Portal</strong>
                    </span>
                </a>

                <button class="navbar-toggler portal-header__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="portal-header__content">
                        <div class="portal-header__nav">
                            <a class="@HeaderNavState("Home", "Index")" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                            <a class="@HeaderNavState("Home", "Announcements")" asp-controller="Home" asp-action="Announcements">Duyurular</a>
                            <div class="dropdown portal-header__nav-dropdown @(isLeavePage ? "is-active" : string.Empty)">
                                <button class="portal-header__nav-link portal-header__nav-dropdown-toggle dropdown-toggle portal-header__nav-link--action @(isLeavePage ? "is-active" : string.Empty)" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    İzin İşlemleri
                                </button>
                                <div class="dropdown-menu portal-header__nav-dropdown-menu">
                                    <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Leave", "RequestLeave") ? "is-active" : string.Empty)" asp-controller="Leave" asp-action="RequestLeave">İzin Talebi Oluştur</a>
                                    <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Leave", "History", "HistoryDetail") ? "is-active" : string.Empty)" asp-controller="Leave" asp-action="History">İzin Geçmişim</a>
                                </div>
                            </div>
                            <a class="@HeaderNavState("Profile", "Index")" asp-controller="Profile" asp-action="Index">Profilim</a>
                            @if (isAdminUser)
                            {
                                <div class="dropdown portal-header__nav-dropdown @(isAdminPage ? "is-active" : string.Empty)">
                                    <button class="portal-header__nav-link portal-header__nav-dropdown-toggle dropdown-toggle @(isAdminPage ? "is-active" : string.Empty)" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Yönetim Paneli
                                    </button>
                                    <div class="dropdown-menu portal-header__nav-dropdown-menu">
                                        <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Admin", "Index") ? "is-active" : string.Empty)" asp-controller="Admin" asp-action="Index">Genel Bakış</a>
                                        <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Admin", "Announcements") ? "is-active" : string.Empty)" asp-controller="Admin" asp-action="Announcements">Duyuru Yönetimi</a>
                                        <a class="portal-header__nav-dropdown-item @(HeaderRouteMatch("Admin", "LeaveRequests") ? "is-active" : string.Empty)" asp-controller="Admin" asp-action="LeaveRequests">İzinler</a>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="portal-header__actions">
                            <span class="portal-header__welcome">Hoş geldiniz, @User.Identity?.Name</span>
                            <a class="portal-header__button portal-header__button--ghost" asp-controller="Account" asp-action="Logout">Çıkış Yap</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
