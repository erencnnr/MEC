@model IEnumerable<MEC.Domain.Entity.School.Announcement>

@{
    ViewData["Title"] = "Tüm Duyurular";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">Tüm Duyurular</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Ana Sayfaya Dön</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-12 mb-3">
                    <a asp-controller="Announcement" asp-action="Detail" asp-route-id="@item.Id" class="announcement-list-card text-decoration-none">
                        <div class="card announcement-list-card__surface">
                            <div class="card-body">
                                <h4 class="card-title fw-bold announcement-list-card__title">@item.Title</h4>
                                <h6 class="card-subtitle mb-3 text-muted">
                                    @* Tarihi şık bir formatta gösteriyoruz *@
                                    Yayınlanma Tarihi: @(item.CreatedDate?.ToString("dd MMMM yyyy, HH:mm") ?? "-")
                                </h6>
                                <p class="card-text text-dark" style="font-size: 1.1rem; line-height: 1.6;">
                                    @Html.Raw(item.Content)
                                </p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center fs-5 py-4 shadow-sm">
            <em>Şu an için sistemde yayınlanmış aktif bir duyuru bulunmamaktadır.</em>
        </div>
    }
</div>
