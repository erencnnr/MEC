@model IEnumerable<MEC.Domain.Entity.School.Announcement>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
                <div class="container-fluid py-2">
                    <h1 class="display-5 fw-bold text-primary">MEC Portal'a Hoş Geldiniz</h1>
                    <p class="col-md-10 fs-5 mt-3">
                        Burası okul yönetim sistemimizin ana sayfasıdır. Güncel gelişmeleri sağ taraftaki duyurular panelinden takip edebilirsiniz.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-header bg-info text-white fw-bold d-flex justify-content-between align-items-center">
                <span class="fs-5">🔔 Güncel Duyurular</span>
                <a asp-controller="Home" asp-action="Announcements" class="btn btn-sm btn-light text-info fw-bold shadow-sm">
                    Tümünü Gör
                </a>
            </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (Model != null && Model.Any())
                        {
                            // Duyuruları en yeni tarihli olan en üstte çıkacak şekilde sıralıyoruz
                            foreach (var item in Model.OrderByDescending(x => x.CreatedDate))
                            {
                                <li class="list-group-item p-3 hover-shadow">
                                    <h6 class="mb-1 text-primary fw-bold">@item.Title</h6>
                                    <p class="mb-2 text-muted" style="font-size: 0.9rem;">
                                    @Html.Raw(item.Content)
                                    </p>
                                    <div class="text-end text-secondary" style="font-size: 0.75rem;">
                                        <em>@(item.CreatedDate?.ToString("dd MMMM yyyy, HH:mm") ?? "")</em>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted text-center py-4">
                                <em>Şu an için aktif bir duyuru bulunmamaktadır.</em>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>